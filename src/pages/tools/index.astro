---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getAllTools, getCategories } from '../../lib/supabase';

const tools = await getAllTools();
const categories = await getCategories();
---

<Layout
  title="500+ AI Tools Directory 2026 | Reviews, Pricing & Ratings"
  description="Browse every AI tool worth knowing. Filter by category, compare pricing, read honest reviews. Updated daily with new AI tools & features."
>
  <main class="tools-page">
    <header class="page-header">
      <h1>All AI Tools</h1>
      <p>{tools.length} tools reviewed and compared</p>
    </header>

    <div class="filters">
      <button class="filter-btn active" data-category="all">All</button>
      {categories.map(cat => (
        <button class="filter-btn" data-category={cat.toLowerCase()}>{cat}</button>
      ))}
    </div>

    <div class="tools-grid" id="tools-grid">
      {tools.map(tool => (
        <div class="tool-wrapper" data-category={tool.category.toLowerCase()}>
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>

    <!-- SEO Content -->
    <section class="seo-content">
      <h2>The Complete AI Tools Directory</h2>
      <p>Welcome to the most comprehensive AI tools directory on the web. We've reviewed and categorized over 500 artificial intelligence tools across every major category—from writing and image generation to coding assistants and data analysis platforms.</p>
      
      <h3>What Makes Our Directory Different</h3>
      <p>Unlike other AI tool lists that simply compile names and links, every tool in our directory includes hands-on reviews, real pricing information, and honest assessments of who each tool is best for. We update our reviews regularly as tools evolve, ensuring you always have accurate information when making decisions.</p>
      
      <h3>How to Use This Directory</h3>
      <p>Use the category filters above to narrow down tools by type—whether you need writing assistance, image generation, video editing, or development tools. Each tool card shows you the key details at a glance: category, pricing tier, and our rating. Click through for detailed reviews including pros, cons, pricing breakdowns, and alternative recommendations.</p>
      
      <h3>Popular Categories</h3>
      <ul class="category-list">
        <li><strong>AI Writing Tools:</strong> Content generators, copywriting assistants, grammar checkers, and long-form writing aids</li>
        <li><strong>AI Image Generators:</strong> Text-to-image tools, photo editors, and design assistants powered by diffusion models</li>
        <li><strong>AI Coding Assistants:</strong> Code completion, debugging helpers, and AI pair programmers for every language</li>
        <li><strong>AI Video Tools:</strong> Avatar generators, video editors, and AI-powered production platforms</li>
        <li><strong>AI Productivity:</strong> Meeting assistants, note-takers, workflow automation, and time management tools</li>
      </ul>
      
      <p>Can't find what you're looking for? Use our <a href="/compare">comparison tool</a> to see how similar tools stack up against each other, or check our <a href="/">homepage</a> for curated recommendations and best-of lists.</p>
    </section>
  </main>
</Layout>

<style>
  .tools-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: #666;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2rem;
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 12px;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    border: none;
    background: white;
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s;
    border: 1px solid #dee2e6;
  }

  .filter-btn:hover {
    background: #e9ecef;
  }

  .filter-btn.active {
    background: #667eea;
    color: white;
    border-color: #667eea;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }

  .tool-wrapper {
    transition: opacity 0.3s, transform 0.3s;
  }

  .tool-wrapper.hidden {
    display: none;
  }

  .seo-content {
    margin-top: 4rem;
    padding: 3rem;
    background: #f8f9fa;
    border-radius: 16px;
  }

  .seo-content h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: #333;
  }

  .seo-content h3 {
    font-size: 1.2rem;
    margin: 2rem 0 0.75rem;
    color: #333;
  }

  .seo-content p {
    color: #555;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .seo-content a {
    color: #667eea;
    text-decoration: none;
  }

  .seo-content a:hover {
    text-decoration: underline;
  }

  .category-list {
    margin: 1rem 0 1.5rem 1.5rem;
    color: #555;
    line-height: 2;
  }

  .category-list li {
    margin-bottom: 0.5rem;
  }

  .category-list strong {
    color: #333;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const toolWrappers = document.querySelectorAll('.tool-wrapper');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.dataset.category;

      // Update active button
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Filter tools
      toolWrappers.forEach(wrapper => {
        if (category === 'all' || wrapper.dataset.category === category) {
          wrapper.classList.remove('hidden');
        } else {
          wrapper.classList.add('hidden');
        }
      });
    });
  });
</script>
