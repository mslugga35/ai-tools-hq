---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Get Your AI Tool Reviewed - Professional Review on AI Tools HQ"
  description="Submit your AI tool for a professional, SEO-optimized review on AI Tools HQ. Permanent placement in front of 10K+ developers and creators. Starting at $299."
>
  <main class="review-page">
    <header class="page-header">
      <div class="badge">Paid Reviews</div>
      <h1>Get Your AI Tool Reviewed</h1>
      <p>A professional, honest review published permanently on AI Tools HQ. SEO-optimized, comparison-ready, and in front of buyers actively researching AI tools.</p>
    </header>

    <section class="stats-row">
      <div class="stat">
        <span class="stat-number">129+</span>
        <span class="stat-label">Tools Reviewed</span>
      </div>
      <div class="stat">
        <span class="stat-number">10K+</span>
        <span class="stat-label">Monthly Visitors</span>
      </div>
      <div class="stat">
        <span class="stat-number">Permanent</span>
        <span class="stat-label">Placement</span>
      </div>
      <div class="stat">
        <span class="stat-number">SEO</span>
        <span class="stat-label">Optimized</span>
      </div>
    </section>

    <section class="how-it-works">
      <h2>How It Works</h2>
      <div class="steps-grid">
        <div class="step-card">
          <span class="step-number">1</span>
          <h3>Submit Your Tool</h3>
          <p>Pick a tier and send us your tool. We'll review the product, features, pricing, and use cases within 5 business days.</p>
        </div>
        <div class="step-card">
          <span class="step-number">2</span>
          <h3>We Review & Publish</h3>
          <p>Our team writes an honest, detailed review with pros, cons, ratings, and schema markup. You get a draft to approve before it goes live.</p>
        </div>
        <div class="step-card">
          <span class="step-number">3</span>
          <h3>Permanent Listing</h3>
          <p>Your review page is indexed by Google, linked from category pages, and stays live permanently. No recurring fees.</p>
        </div>
      </div>
    </section>

    <section class="tiers">
      <h2>Review Tiers</h2>
      <p class="tiers-sub">One-time payment. Permanent placement. Honest reviews only.</p>

      <div class="tier-grid">
        <div class="tier-card">
          <div class="tier-header">
            <span class="tier-name">Standard Review</span>
            <div class="tier-price">
              <span class="price">$299</span>
              <span class="per">one-time</span>
            </div>
          </div>
          <ul class="tier-features">
            <li>Detailed review page (800+ words)</li>
            <li>Pros, cons, and overall rating</li>
            <li>SEO-optimized title, meta, and schema markup</li>
            <li>Listed in relevant category pages</li>
            <li>Permanent indexed page on ai-tools-hq.com</li>
            <li>Your pricing and link included</li>
          </ul>
          <div class="tier-note">Best for: New tools seeking visibility</div>
          <a href="mailto:hello@ai-tools-hq.com?subject=Standard Review ($299)&body=Hi, I'd like a Standard Review for my AI tool.%0A%0ATool name:%0AWebsite:%0ACategory:%0AAnything else:" class="tier-cta">Get Reviewed</a>
        </div>

        <div class="tier-card tier-popular">
          <div class="popular-badge">Most Popular</div>
          <div class="tier-header">
            <span class="tier-name">Featured Review</span>
            <div class="tier-price">
              <span class="price">$599</span>
              <span class="per">one-time</span>
            </div>
          </div>
          <ul class="tier-features">
            <li>Everything in Standard Review</li>
            <li>1,500+ word in-depth review</li>
            <li>"Featured" badge on your tool card</li>
            <li>Priority placement in category listing</li>
            <li>Included in "Best Of" roundup pages</li>
            <li>Social media announcement post</li>
            <li>Backlink from our sitemap and internal pages</li>
          </ul>
          <div class="tier-note">Best for: Tools ready to compete for category authority</div>
          <a href="mailto:hello@ai-tools-hq.com?subject=Featured Review ($599)&body=Hi, I'd like a Featured Review for my AI tool.%0A%0ATool name:%0AWebsite:%0ACategory:%0AKey differentiator:" class="tier-cta tier-cta-primary">Get Featured</a>
        </div>

        <div class="tier-card tier-premium">
          <div class="tier-header">
            <span class="tier-name">Premium Package</span>
            <div class="tier-price">
              <span class="price">$999</span>
              <span class="per">one-time</span>
            </div>
          </div>
          <ul class="tier-features">
            <li>Everything in Featured Review</li>
            <li>Dedicated comparison page vs your top competitor</li>
            <li>Listed on the "[Competitor] alternatives" page</li>
            <li>2,000+ word review with use-case deep dives</li>
            <li>Newsletter mention to our subscriber list</li>
            <li>Monthly ranking report for 3 months</li>
            <li>Priority review (published within 48 hours)</li>
          </ul>
          <div class="tier-note">Best for: Established tools going head-to-head with market leaders</div>
          <a href="mailto:hello@ai-tools-hq.com?subject=Premium Package ($999)&body=Hi, I'd like the Premium Package.%0A%0ATool name:%0AWebsite:%0AMain competitor:%0AKey differentiators:" class="tier-cta">Go Premium</a>
        </div>
      </div>
    </section>

    <section class="what-you-get">
      <h2>What Every Review Includes</h2>
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">🔍</span>
          <h3>Honest Assessment</h3>
          <p>We test the product ourselves. Reviews include real pros AND cons. Readers trust us because we don't sugarcoat.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📈</span>
          <h3>SEO That Ranks</h3>
          <p>Every page is optimized with structured data, meta tags, and internal linking. Your tool shows up when people search.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🔗</span>
          <h3>Permanent Placement</h3>
          <p>Not a blog post that disappears. Your review page lives permanently in our directory, gaining authority over time.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📊</span>
          <h3>Category Integration</h3>
          <p>Auto-linked from category pages, comparison matrices, and "best of" roundups. Multiple discovery paths.</p>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <h2>Common Questions</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3>Are reviews guaranteed to be positive?</h3>
          <p>No. We write honest reviews. You'll see a draft before publication and can request factual corrections, but we don't remove legitimate cons. This is what makes our reviews trustworthy.</p>
        </div>
        <div class="faq-item">
          <h3>How long until my review is live?</h3>
          <p>Standard: 5 business days. Featured: 3 business days. Premium: 48 hours. You'll receive a draft for approval before publication.</p>
        </div>
        <div class="faq-item">
          <h3>Can I update the review later?</h3>
          <p>Yes. If your product launches major new features, let us know and we'll update the review at no extra charge (once per quarter).</p>
        </div>
        <div class="faq-item">
          <h3>Do you disclose paid reviews?</h3>
          <p>The listing itself is not labeled "paid review." However, any sponsored badges or featured placements are clearly marked per FTC guidelines.</p>
        </div>
        <div class="faq-item">
          <h3>Can I include my affiliate link?</h3>
          <p>Yes. All tiers include your referral/affiliate URL on the review page and any comparison pages.</p>
        </div>
      </div>
    </section>

    <section class="cta-box">
      <h2>Ready to get your tool in front of buyers?</h2>
      <p>Email us with your tool details. We'll confirm your tier and timeline within 24 hours.</p>
      <a href="mailto:hello@ai-tools-hq.com?subject=Review Inquiry" class="btn-primary">Submit Your Tool</a>
      <p class="cta-sub">Questions? Reach out on X: <a href="https://x.com/AIToolsHQ" target="_blank" rel="noopener">@AIToolsHQ</a></p>
    </section>
  </main>
</Layout>

<style>
  .review-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 8rem 2rem 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .badge {
    display: inline-block;
    padding: 0.3rem 1rem;
    background: var(--success-bg);
    border: 1px solid var(--success-border-strong);
    border-radius: 50px;
    color: var(--accent-primary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 400;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .page-header p {
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 4rem;
  }

  .stat {
    background: var(--bg-secondary);
    padding: 1.5rem;
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* How It Works */
  .how-it-works {
    margin-bottom: 4rem;
  }

  .how-it-works h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 2rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .step-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-radius: 50%;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .step-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .step-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Tiers */
  .tiers h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .tiers-sub {
    text-align: center;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .tier-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s;
  }

  .tier-card:hover { border-color: var(--white-20); }
  .tier-popular { border-color: var(--accent-primary); background: var(--white-02); }
  .tier-premium { border-color: var(--accent-glow-strong); }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent-primary);
    color: var(--bg-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 1rem;
    border-radius: 50px;
    white-space: nowrap;
  }

  .tier-header { display: flex; justify-content: space-between; align-items: flex-start; }
  .tier-name { font-weight: 600; color: var(--text-primary); font-size: 1rem; }
  .tier-price { text-align: right; }
  .price { font-size: 1.75rem; font-weight: 700; color: var(--accent-primary); }
  .per { font-size: 0.85rem; color: var(--text-secondary); }

  .tier-features { list-style: none; margin: 0; padding: 0; flex: 1; }
  .tier-features li {
    padding: 0.4rem 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    display: flex;
    gap: 0.5rem;
  }
  .tier-features li::before { content: "\2713"; color: var(--accent-primary); font-weight: 700; flex-shrink: 0; }

  .tier-note {
    font-size: 0.8rem;
    color: var(--white-50);
    font-style: italic;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tier-cta {
    display: block;
    text-align: center;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: 50px;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s;
    text-decoration: none;
  }

  .tier-cta:hover { border-color: var(--accent-primary); color: var(--accent-primary); }

  .tier-cta-primary {
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-color: var(--accent-primary);
  }

  .tier-cta-primary:hover { background: var(--accent-secondary); color: var(--bg-primary); }

  /* What You Get */
  .what-you-get { margin-bottom: 4rem; }

  .what-you-get h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 2rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .feature-icon { font-size: 2rem; display: block; margin-bottom: 0.75rem; }
  .feature-card h3 { font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; }
  .feature-card p { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6; }

  /* FAQ */
  .faq-section { margin-bottom: 4rem; }

  .faq-section h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 2rem;
  }

  .faq-list { display: flex; flex-direction: column; gap: 1rem; }

  .faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
  }

  .faq-item h3 { font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; }
  .faq-item p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; }

  /* CTA */
  .cta-box {
    margin-top: 2rem;
    padding: 3rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    text-align: center;
  }

  .cta-box h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .cta-box > p { color: var(--text-secondary); margin-bottom: 1.5rem; }

  .btn-primary {
    display: inline-block;
    padding: 0.875rem 2.5rem;
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .btn-primary:hover { background: var(--accent-secondary); transform: translateY(-2px); }
  .cta-sub { color: var(--text-secondary); font-size: 0.9rem; }
  .cta-sub a { color: var(--accent-primary); }

  @media (max-width: 768px) {
    .review-page { padding: 7rem 1.5rem 3rem; }
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .tier-grid { grid-template-columns: 1fr; }
    .steps-grid { grid-template-columns: 1fr; }
    .features-grid { grid-template-columns: 1fr; }
  }
</style>
