---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | AI Tools HQ"
  description="The page you're looking for doesn't exist. Browse our AI tools directory to find what you need."
  noindex={true}
>
  <main class="not-found">
    <div class="content">
      <span class="error-code">404</span>
      <h1>Page Not Found</h1>
      <p>The page you're looking for doesn't exist or has been moved.</p>

      <form class="search-form" action="/tools" method="get">
        <input
          type="search"
          name="q"
          placeholder="Search AI tools..."
          class="search-input"
          aria-label="Search AI tools"
          autocomplete="off"
        />
        <button type="submit" class="search-btn" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>

      <div class="actions">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="/tools" class="btn-secondary">Browse Tools</a>
      </div>
      <div class="quick-links">
        <h3>Popular Categories</h3>
        <div class="links">
          <a href="/category/writing">Writing Tools</a>
          <a href="/category/image">Image Tools</a>
          <a href="/category/coding">Coding Tools</a>
          <a href="/category/video">Video Tools</a>
          <a href="/category/productivity">Productivity</a>
        </div>
      </div>
      <div class="quick-links">
        <h3>Top Resources</h3>
        <div class="links">
          <a href="/compare">Compare Tools</a>
          <a href="/best/ai-writing-tools">Best Writing Tools</a>
          <a href="/best/free-ai-tools">Free AI Tools</a>
          <a href="/best/ai-image-generators">Image Generators</a>
          <a href="/blog">Blog</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 2rem 4rem;
  }

  .content {
    text-align: center;
    max-width: 600px;
  }

  .error-code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 400;
    color: var(--accent-primary);
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
    opacity: 0.3;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 400;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .search-form {
    display: flex;
    gap: 0;
    max-width: 400px;
    margin: 0 auto 2rem;
    position: relative;
  }

  .search-input {
    flex: 1;
    padding: 0.875rem 1.25rem;
    padding-right: 3rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 50px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input:focus {
    border-color: var(--accent-primary);
  }

  .search-btn {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: var(--accent-primary);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--bg-primary);
    transition: background 0.2s ease;
  }

  .search-btn:hover {
    background: var(--accent-secondary);
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .btn-primary, .btn-secondary {
    padding: 0.875rem 1.75rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s var(--ease-out-expo);
  }

  .btn-primary {
    background: var(--accent-primary);
    color: var(--bg-primary);
  }

  .btn-primary:hover {
    background: var(--accent-secondary);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -10px var(--accent-glow);
  }

  .btn-secondary {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .quick-links {
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .quick-links h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .links a {
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 50px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .links a:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
</style>
