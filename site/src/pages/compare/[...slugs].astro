---
import Layout from '../../layouts/Layout.astro';
import { getAllTools } from '../../lib/supabase';
import { getStaggeredDate, generateComparisonPairs, splitBullets, isIndexedComparison } from '../../lib/seo-utils';

export async function getStaticPaths() {
  const allTools = await getAllTools();
  const pairs = generateComparisonPairs(allTools);

  return pairs.map(([tool1, tool2]) => ({
    params: { slugs: `${tool1.slug}/${tool2.slug}` },
    props: { tool1, tool2 }
  }));
}

const { tool1, tool2 } = Astro.props;

// Only index high-value comparison pairs; noindex the rest to avoid thin content penalty
const shouldIndex = isIndexedComparison(tool1.slug, tool2.slug);

// Upgrade affiliate links: homepage → pricing/trial pages + sub1=compare-{slug} attribution
const buildCompareLink = (affiliateLink: string, slug: string): string => {
  if (!affiliateLink) return '#';
  let url = affiliateLink
    .replace('https://synthesia.io?', 'https://synthesia.io/pricing?')
    .replace('https://baremetrics.com/?', 'https://baremetrics.com/pricing?')
    .replace('https://www.signwell.com/?', 'https://app.signwell.com/accounts/sign-up?')
    .replace('https://emailoctopus.com/?', 'https://emailoctopus.com/pricing?')
    .replace('https://outseta.com/?', 'https://outseta.com/pricing?');
  if (!url.includes('sub1=')) {
    url += (url.includes('?') ? '&' : '?') + `sub1=compare-${slug}`;
  }
  return url;
};

const tool1Link = buildCompareLink(tool1.affiliateLink, tool1.slug);
const tool2Link = buildCompareLink(tool2.affiliateLink, tool2.slug);

// Pre-parse bullet text (used in table, verdict, and schema)
const tool1Pros = splitBullets(tool1.pros);
const tool1Cons = splitBullets(tool1.cons);
const tool2Pros = splitBullets(tool2.pros);
const tool2Cons = splitBullets(tool2.cons);

const datePublished = getStaggeredDate(tool1.slug + tool2.slug);

// Schema markup for comparison page
const comparisonSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${tool1.name} vs ${tool2.name} - Which AI Tool is Better in 2026?`,
  "author": {
    "@type": "Organization",
    "name": "AI Tools HQ"
  },
  "publisher": {
    "@type": "Organization",
    "name": "AI Tools HQ",
    "url": "https://www.ai-tools-hq.com"
  },
  "datePublished": datePublished,
  "dateModified": new Date().toISOString().split('T')[0]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.ai-tools-hq.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Compare",
      "item": "https://www.ai-tools-hq.com/compare"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${tool1.name} vs ${tool2.name}`,
      "item": `https://www.ai-tools-hq.com/compare/${tool1.slug}/${tool2.slug}`
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the difference between ${tool1.name} and ${tool2.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${tool1.name} (${tool1.pricing}) and ${tool2.name} (${tool2.pricing}) are both ${tool1.category.toLowerCase()} tools. ${tool1.name} focuses on ${tool1.description}. ${tool2.name} focuses on ${tool2.description}.`
      }
    },
    {
      "@type": "Question",
      "name": `Which is cheaper, ${tool1.name} or ${tool2.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${tool1.name} pricing: ${tool1.pricing}. ${tool2.name} pricing: ${tool2.pricing}.`
      }
    },
    {
      "@type": "Question",
      "name": `What are the pros and cons of ${tool1.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Pros: ${tool1Pros.join(', ') || 'See full review'}. Cons: ${tool1Cons.join(', ') || 'See full review'}.`
      }
    }
  ]
};
---

<Layout
  title={`${tool1.name} vs ${tool2.name} - Which is Better? (2026 Comparison) | AI Tools HQ`}
  description={`Compare ${tool1.name} and ${tool2.name} side by side. See features, pricing, pros & cons to decide which AI tool is right for you.`}
  noindex={!shouldIndex}
>
  <script type="application/ld+json" set:html={JSON.stringify(comparisonSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main class="compare-detail">
    <header class="compare-header">
      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/compare">Compare</a> / {tool1.name} vs {tool2.name}
      </div>

      <h1>{tool1.name} vs {tool2.name}</h1>
      <p>A detailed comparison to help you choose the right tool</p>
    </header>

    <p class="ftc-disclosure">Some links on this page are affiliate links — we may earn a commission at no cost to you. <a href="/about#affiliate-disclosure">Learn more</a></p>

    <div class="compare-cta-strip">
      <a href={tool1Link} class="cta-tool-btn" target="_blank" rel="noopener sponsored">
        Try {tool1.name} Free →
      </a>
      <span class="cta-or">or</span>
      <a href={tool2Link} class="cta-tool-btn" target="_blank" rel="noopener sponsored">
        Try {tool2.name} Free →
      </a>
    </div>

    <div class="comparison-table">
      <div class="table-header">
        <div class="header-cell"></div>
        <div class="header-cell tool-header">
          <h2>{tool1.name}</h2>
          <span class="category">{tool1.category}</span>
        </div>
        <div class="header-cell tool-header">
          <h2>{tool2.name}</h2>
          <span class="category">{tool2.category}</span>
        </div>
      </div>

      <div class="table-row">
        <div class="row-label">Pricing</div>
        <div class="row-cell">{tool1.pricing}</div>
        <div class="row-cell">{tool2.pricing}</div>
      </div>

      <div class="table-row">
        <div class="row-label">Best For</div>
        <div class="row-cell">{tool1.description}</div>
        <div class="row-cell">{tool2.description}</div>
      </div>

      <div class="table-row">
        <div class="row-label">Pros</div>
        <div class="row-cell">
          <ul class="pros-list">
            {tool1Pros.map(pro => <li>{pro}</li>)}
          </ul>
        </div>
        <div class="row-cell">
          <ul class="pros-list">
            {tool2Pros.map(pro => <li>{pro}</li>)}
          </ul>
        </div>
      </div>

      <div class="table-row">
        <div class="row-label">Cons</div>
        <div class="row-cell">
          <ul class="cons-list">
            {tool1Cons.map(con => <li>{con}</li>)}
          </ul>
        </div>
        <div class="row-cell">
          <ul class="cons-list">
            {tool2Cons.map(con => <li>{con}</li>)}
          </ul>
        </div>
      </div>

      <div class="table-row cta-row">
        <div class="row-label">Try It</div>
        <div class="row-cell">
          <a href={tool1Link} class="btn-primary" target="_blank" rel="noopener sponsored">
            Try {tool1.name} →
          </a>
        </div>
        <div class="row-cell">
          <a href={tool2Link} class="btn-primary" target="_blank" rel="noopener sponsored">
            Try {tool2.name} →
          </a>
        </div>
      </div>
    </div>

    <section class="detailed-comparison">
      <h2>Detailed Comparison</h2>

      <div class="tool-detail">
        <h3>{tool1.name} Overview</h3>
        <p>{tool1.review}</p>
        <a href={`/tools/${tool1.slug}`}>Read full {tool1.name} review →</a>
      </div>

      <div class="tool-detail">
        <h3>{tool2.name} Overview</h3>
        <p>{tool2.review}</p>
        <a href={`/tools/${tool2.slug}`}>Read full {tool2.name} review →</a>
      </div>
    </section>

    <section class="verdict">
      <h2>Our Verdict</h2>
      <div class="verdict-content">
        <p>
          Both <strong>{tool1.name}</strong> ({tool1.pricing}) and <strong>{tool2.name}</strong> ({tool2.pricing}) compete in the {tool1.category} category, but they serve different needs.
        </p>
        <p>
          <strong>Choose {tool1.name} if:</strong>
          {tool1Pros.length > 0 ? ` You value ${tool1Pros.slice(0, 2).map(p => p.toLowerCase()).join(' and ')}.` : ' You need a solid option in this space.'}
          {tool1.pricing.includes('Free') ? ' Plus, you can start for free.' : ''}
        </p>
        <p>
          <strong>Choose {tool2.name} if:</strong>
          {tool2Pros.length > 0 ? ` You prioritize ${tool2Pros.slice(0, 2).map(p => p.toLowerCase()).join(' and ')}.` : ' You want an alternative approach.'}
          {tool2.pricing.includes('Free') ? ' It also offers a free tier.' : ''}
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .compare-detail {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .breadcrumb {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .breadcrumb a {
    color: var(--accent-primary);
  }

  .ftc-disclosure {
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.7;
    margin: 0 0 1.5rem;
  }

  .ftc-disclosure a {
    color: inherit;
    text-decoration: underline;
  }

  .compare-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .compare-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .compare-header p {
    color: var(--text-secondary);
  }

  .compare-cta-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--accent-glow);
    border: 1px solid var(--border-glow);
    border-radius: 12px;
    flex-wrap: wrap;
  }

  .cta-tool-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.5rem;
    background: var(--accent-primary);
    color: #fff;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: opacity 0.15s;
  }

  .cta-tool-btn:hover {
    opacity: 0.85;
  }

  .cta-or {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .comparison-table {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 3rem;
  }

  .table-header {
    display: grid;
    grid-template-columns: 150px 1fr 1fr;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-cell {
    padding: 1.5rem;
    text-align: center;
  }

  .tool-header h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }

  .category {
    background: var(--accent-primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
  }

  .table-row {
    display: grid;
    grid-template-columns: 150px 1fr 1fr;
    border-bottom: 1px solid var(--border-subtle);
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .row-label {
    padding: 1.5rem;
    background: var(--bg-secondary);
    font-weight: 600;
    display: flex;
    align-items: center;
    color: var(--text-primary);
  }

  .row-cell {
    padding: 1.5rem;
    border-left: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .pros-list, .cons-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pros-list li {
    padding: 0.25rem 0;
    color: var(--text-secondary);
  }

  .pros-list li::before {
    content: "✓ ";
    color: var(--success);
    font-weight: 700;
  }

  .cons-list li {
    padding: 0.25rem 0;
    color: var(--text-secondary);
  }

  .cons-list li::before {
    content: "✗ ";
    color: var(--error);
    font-weight: 700;
  }

  .cta-row .row-cell {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .btn-primary {
    padding: 0.75rem 1.5rem;
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s var(--ease-out-expo);
  }

  .btn-primary:hover {
    background: var(--accent-secondary);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -10px var(--accent-glow);
  }

  .detailed-comparison h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .tool-detail {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 1.5rem;
  }

  .tool-detail h3 {
    margin: 0 0 1rem;
    color: var(--text-primary);
  }

  .tool-detail p {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .tool-detail a {
    color: var(--accent-primary);
    font-weight: 500;
  }

  .verdict {
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
    color: white;
    padding: 2rem;
    border-radius: 16px;
    margin-top: 3rem;
  }

  .verdict h2 {
    margin: 0 0 1rem;
  }

  .verdict-content p {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .compare-detail {
      padding: 7rem 1.5rem 3rem;
    }

    .table-header,
    .table-row {
      grid-template-columns: 1fr;
    }

    .row-label {
      border-bottom: 1px solid var(--border-subtle);
    }

    .row-cell {
      border-left: none;
    }
  }
</style>
