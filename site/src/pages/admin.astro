---
// Admin Dashboard - Hidden page, noindex
// Access: https://www.ai-tools-hq.com/admin
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>AI Tools HQ - Admin Dashboard</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: var(--font-body); background: #0f172a /* ds-exception: admin-only palette */; color: #e2e8f0 /* ds-exception: admin-only palette */; padding: 24px; }
  h1 { font-size: 28px; margin-bottom: 8px; }
  .subtitle { color: #94a3b8 /* ds-exception: admin-only palette */; margin-bottom: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 32px; }
  .card { background: #1e293b /* ds-exception: admin-only palette */; border-radius: 12px; padding: 20px; border: 1px solid #334155 /* ds-exception: admin-only palette */; }
  .card h3 { font-size: 13px; color: #94a3b8 /* ds-exception: admin-only palette */; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
  .card .value { font-size: 36px; font-weight: 700; }
  .card .value.green { color: #4ade80 /* ds-exception: admin-only palette */; }
  .card .value.yellow { color: #facc15 /* ds-exception: admin-only palette */; }
  .card .value.red { color: #f87171 /* ds-exception: admin-only palette */; }
  .card .value.blue { color: #60a5fa /* ds-exception: admin-only palette */; }
  .section { background: #1e293b /* ds-exception: admin-only palette */; border-radius: 12px; padding: 24px; border: 1px solid #334155 /* ds-exception: admin-only palette */; margin-bottom: 24px; }
  .section h2 { font-size: 18px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; padding: 10px 12px; border-bottom: 2px solid #334155 /* ds-exception: admin-only palette */; font-size: 12px; text-transform: uppercase; color: #94a3b8 /* ds-exception: admin-only palette */; letter-spacing: 1px; }
  td { padding: 10px 12px; border-bottom: 1px solid #1e293b /* ds-exception: admin-only palette */; font-size: 14px; }
  tr:hover td { background: #253348 /* ds-exception: admin-only palette */; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 99px; font-size: 12px; font-weight: 600; }
  .badge-green { background: #166534 /* ds-exception: admin-only palette */; color: #4ade80 /* ds-exception: admin-only palette */; }
  .badge-yellow { background: #713f12 /* ds-exception: admin-only palette */; color: #facc15 /* ds-exception: admin-only palette */; }
  .badge-red { background: #7f1d1d /* ds-exception: admin-only palette */; color: #f87171 /* ds-exception: admin-only palette */; }
  .badge-blue { background: #1e3a5f /* ds-exception: admin-only palette */; color: #60a5fa /* ds-exception: admin-only palette */; }
  .workflow-card { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid #334155 /* ds-exception: admin-only palette */; }
  .workflow-card:last-child { border-bottom: none; }
  .workflow-name { font-weight: 600; }
  .workflow-schedule { color: #94a3b8 /* ds-exception: admin-only palette */; font-size: 13px; }
  .btn { background: #3b82f6 /* ds-exception: admin-only palette */; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; }
  .btn:hover { background: #2563eb /* ds-exception: admin-only palette */; }
  .btn:disabled { background: #475569 /* ds-exception: admin-only palette */; cursor: not-allowed; }
  .btn-sm { padding: 6px 14px; font-size: 12px; }
  .loading { color: #94a3b8 /* ds-exception: admin-only palette */; font-style: italic; }
  .doc-section { margin-bottom: 20px; }
  .doc-section h3 { color: #60a5fa /* ds-exception: admin-only palette */; margin-bottom: 8px; font-size: 15px; }
  .doc-section p, .doc-section li { color: #cbd5e1 /* ds-exception: admin-only palette */; line-height: 1.7; font-size: 14px; }
  .doc-section ul { padding-left: 20px; }
  .doc-section ol { padding-left: 20px; }
  .doc-section code { background: #334155 /* ds-exception: admin-only palette */; padding: 2px 6px; border-radius: 4px; font-size: 13px; color: #fbbf24 /* ds-exception: admin-only palette */; }
  .tabs { display: flex; gap: 4px; margin-bottom: 20px; flex-wrap: wrap; }
  .tab { padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 14px; background: transparent; color: #94a3b8 /* ds-exception: admin-only palette */; border: 1px solid transparent; }
  .tab.active { background: #334155 /* ds-exception: admin-only palette */; color: #e2e8f0 /* ds-exception: admin-only palette */; border-color: #475569 /* ds-exception: admin-only palette */; }
  .tab:hover { color: #e2e8f0 /* ds-exception: admin-only palette */; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .refresh-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
  .last-refresh { color: #64748b /* ds-exception: admin-only palette */; font-size: 13px; }
  .affiliate-link { color: #60a5fa /* ds-exception: admin-only palette */; text-decoration: none; }
  .affiliate-link:hover { text-decoration: underline; }
  .progress-bar { height: 8px; background: #334155 /* ds-exception: admin-only palette */; border-radius: 4px; overflow: hidden; margin-top: 8px; }
  .progress-fill { height: 100%; border-radius: 4px; transition: width 0.5s var(--ease-out-expo); }
  .progress-fill.green { background: #4ade80 /* ds-exception: admin-only palette */; }
  .progress-fill.blue { background: #60a5fa /* ds-exception: admin-only palette */; }
  .filter-row { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .filter-btn { padding: 4px 12px; border-radius: 99px; border: 1px solid #475569 /* ds-exception: admin-only palette */; background: transparent; color: #94a3b8 /* ds-exception: admin-only palette */; cursor: pointer; font-size: 12px; }
  .filter-btn.active { background: #3b82f6 /* ds-exception: admin-only palette */; color: white; border-color: #3b82f6 /* ds-exception: admin-only palette */; }
  @media (max-width: 640px) {
    body { padding: 12px; }
    .card .value { font-size: 28px; }
    .tabs { gap: 2px; }
    .tab { padding: 6px 10px; font-size: 12px; }
  }
</style>
</head>
<body>

