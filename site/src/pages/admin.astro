</div>

<script>
const SUPABASE_URL = 'https://ebhtzgimevacvcgiyesc.supabase.co';
const ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImViaHR6Z2ltZXZhY3ZjZ2l5ZXNjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTI4MDIyMTksImV4cCI6MjA2ODM3ODIxOX0.msMqXGX33MIygHQWG4n2BdP8JVLOR9Yi5WkiDRwZEbY';

const AFFILIATE_PROGRAMS = {
  'synthesia': { status: 'active', link: 'https://synthesia.io?via=matt-morales' },
  'elevenlabs': { status: 'active', link: 'https://try.elevenlabs.io/f4il4v3cm496' },
  'zaap': { status: 'active', link: 'https://app.zaap.ai/create-url/?ref=matt' },
  'baremetrics': { status: 'active', link: 'https://baremetrics.com/?via=matt' },
  'signwell': { status: 'active', link: 'https://www.signwell.com/?via=matt-morales' },
  'emailoctopus': { status: 'active', link: 'https://emailoctopus.com/?ref=matt' },
  'outseta': { status: 'active', link: 'https://outseta.com/?via=matt-morales' },
  'notion-ai': { status: 'pending', signup: 'https://www.notion.com/affiliates', commission: '50% recurring 12mo' },
  'copy-ai': { status: 'pending', signup: 'https://affiliates.copy.ai/apply', commission: '45% first 12mo' },
  'frase': { status: 'pending', signup: 'https://affiliates.frase.io', commission: '30-40% recurring' },
  'jasper': { status: 'pending', signup: 'https://www.jasper.ai/partners/affiliates', commission: '30% recurring 12mo' },
  'writesonic': { status: 'pending', signup: 'https://affiliates.writesonic.com', commission: '30% lifetime' },
  'gamma': { status: 'pending', signup: 'https://gammaapp.partnerstack.com', commission: '30% all payments' },
  'grammarly': { status: 'pending', signup: 'https://www.shareasale.com/shareasale.cfm?merchantID=26748', commission: '$20/premium sale' },
  'surfer-seo': { status: 'pending', signup: 'https://market.partnerstack.com/page/surferseo', commission: '15-25% tiered' },
  'kling-ai': { status: 'pending', signup: 'https://app.klingai.com/global/commission-share', commission: '25%' },
  'descript': { status: 'pending', signup: 'https://www.descript.com/affiliate', commission: '$25 flat' },
  'heygen': { status: 'pending', signup: 'https://heygen.getrewardful.com/signup', commission: '20% recurring 12mo' },
  'lovable': { status: 'pending', signup: 'https://lovable.dev/affiliates', commission: '20-30% recurring 12mo' },
  'invideo': { status: 'pending', signup: 'https://invideo.io/affiliates', commission: '50% first payment' },
  'pictory': { status: 'pending', signup: 'https://pictory.ai/affiliates', commission: '30% recurring' },
};

let allTools = [];
let currentFilter = 'all';

async function supaFetch(path) {
  const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, {
    headers: { 'apikey': ANON_KEY, 'Authorization': `Bearer ${ANON_KEY}` }
  });
  return res.json();
}

function switchTab(name) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelector(`.tab[data-tab="${name}"]`).classList.add('active');
  document.getElementById('tab-' + name).classList.add('active');
}

document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => switchTab(tab.dataset.tab));
});

function filterTools(category) {
  currentFilter = category;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.cat === category));
  renderTools();
}

function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function renderTools() {
  const filtered = currentFilter === 'all' ? allTools : allTools.filter(t => t.category === currentFilter);
  const tbody = document.getElementById('toolsBody');
  tbody.innerHTML = filtered.map(t => `
    <tr>
      <td><strong>${escapeHtml(t.name)}</strong></td>
      <td>${escapeHtml(t.category || '-')}</td>
      <td>${t.review ? '<span class="badge badge-green">Done</span>' : '<span class="badge badge-red">Missing</span>'}</td>
      <td>${t.affiliate_link ? '<span class="badge badge-green">Set</span>' : (AFFILIATE_PROGRAMS[t.slug] ? '<span class="badge badge-yellow">Available</span>' : '<span class="badge badge-red">None</span>')}</td>
      <td>${escapeHtml(t.pricing || '-')}</td>
    </tr>
  `).join('');
}

async function loadAll() {
  try {
    allTools = await supaFetch('tools?select=id,name,slug,category,pricing,review,affiliate_link,website&order=name');

    const total = allTools.length;
    const withReview = allTools.filter(t => t.review).length;
    const withAffiliate = allTools.filter(t => t.affiliate_link).length;

    document.getElementById('totalTools').textContent = total;
    document.getElementById('reviewsDone').textContent = withReview;
    document.getElementById('affiliateCount').textContent = withAffiliate;
    document.getElementById('missingReviews').textContent = total - withReview;

    const reviewPct = total > 0 ? Math.round((withReview / total) * 100) : 0;
    const affiliatePct = total > 0 ? Math.round((withAffiliate / total) * 100) : 0;
    document.getElementById('reviewPct').textContent = `${withReview}/${total} (${reviewPct}%)`;
    document.getElementById('affiliatePct').textContent = `${withAffiliate}/${total} (${affiliatePct}%)`;
    document.getElementById('reviewBar').style.width = reviewPct + '%';
    document.getElementById('affiliateBar').style.width = affiliatePct + '%';

    const categories = [...new Set(allTools.map(t => t.category).filter(Boolean))].sort();
    const filterDiv = document.getElementById('categoryFilters');
    filterDiv.innerHTML = `<button class="filter-btn active" data-cat="all" onclick="filterTools('all')">All (${total})</button>` +
      categories.map(c => {
        const count = allTools.filter(t => t.category === c).length;
        return `<button class="filter-btn" data-cat="${escapeHtml(c)}" onclick="filterTools('${escapeHtml(c)}')">${escapeHtml(c)} (${count})</button>`;
      }).join('');

    renderTools();

    const affBody = document.getElementById('affiliateBody');
    const affRows = allTools
      .filter(t => t.affiliate_link || AFFILIATE_PROGRAMS[t.slug])
      .sort((a, b) => {
        const aHas = a.affiliate_link ? 0 : 1;
        const bHas = b.affiliate_link ? 0 : 1;
        return aHas - bHas || a.name.localeCompare(b.name);
      })
      .map(t => {
        const prog = AFFILIATE_PROGRAMS[t.slug];
        if (t.affiliate_link) {
          return `<tr>
            <td><strong>${escapeHtml(t.name)}</strong></td>
            <td><span class="badge badge-green">Active</span></td>
            <td><a class="affiliate-link" href="${escapeHtml(t.affiliate_link)}" target="_blank" rel="noopener">${escapeHtml(t.affiliate_link.substring(0, 50))}...</a></td>
            <td>${escapeHtml(t.category || '-')}</td>
          </tr>`;
        } else if (prog) {
          return `<tr>
            <td><strong>${escapeHtml(t.name)}</strong></td>
            <td><span class="badge badge-yellow">${escapeHtml(prog.commission || 'Pending Signup')}</span></td>
            <td><a class="affiliate-link" href="${escapeHtml(prog.signup)}" target="_blank" rel="noopener">Sign Up</a></td>
            <td>${escapeHtml(t.category || '-')}</td>
          </tr>`;
        }
        return '';
      }).join('');
    affBody.innerHTML = affRows || '<tr><td colspan="4">No affiliate data</td></tr>';

    document.getElementById('lastRefresh').textContent = 'Last refresh: ' + new Date().toLocaleTimeString();
  } catch (err) {
    console.error('Dashboard load error:', err);
    document.getElementById('lastRefresh').textContent = 'Error: ' + err.message;
  }
}

loadAll();
</script>

</body>
</html>
