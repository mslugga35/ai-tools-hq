---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getAllTools, getCategories } from '../../lib/supabase';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map(cat => ({
    params: { category: cat.toLowerCase() },
    props: { categoryName: cat }
  }));
}

const { categoryName } = Astro.props;
const allTools = await getAllTools();
const tools = allTools.filter(t => t.category.toLowerCase() === categoryName.toLowerCase());

const categoryDescriptions: Record<string, string> = {
  'Writing': 'AI writing assistants that help you create content faster, from blog posts and marketing copy to social media captions and email sequences. These tools use large language models to generate, rewrite, and polish text while maintaining your brand voice. We evaluate them on output quality, tone control, plagiarism-free content, and integration with popular publishing platforms.',
  'Image': 'AI image generators and editors that create stunning visuals from text prompts, including photorealistic renders, illustrations, and design mockups. Whether you need social media graphics, product shots, or concept art, these tools handle it in seconds. We compare them on image quality, style variety, resolution options, and commercial licensing terms.',
  'Video': 'AI video creation tools that automate editing, generate realistic avatars, add captions, and produce professional videos in minutes instead of hours. From short-form social content to training videos and marketing clips, these platforms reduce production costs dramatically. Key evaluation criteria include output quality, avatar realism, language support, and export options.',
  'Audio': 'AI voice generators and audio tools for podcasts, voiceovers, audiobooks, and music creation. These platforms clone voices, convert text to natural-sounding speech, and even compose background music. We assess them on voice quality, language coverage, latency, and licensing flexibility for commercial use.',
  'Coding': 'AI coding assistants that write, review, and debug code across dozens of programming languages. They integrate directly into your IDE to provide intelligent autocomplete, refactoring suggestions, and test generation. We evaluate them on code accuracy, language support, context window size, and security of your codebase.',
  'Productivity': 'AI productivity tools that automate repetitive tasks, summarize meetings, manage notes, and help you work smarter across your entire workflow. From smart calendars to AI-powered project managers, these tools save hours each week. We compare them on automation depth, app integrations, learning curve, and privacy policies.',
  'Marketing': 'AI marketing tools for ad creation, SEO copywriting, campaign optimization, and audience analysis. They help marketers produce more content, test more variations, and optimize spend across channels. Key evaluation criteria include content quality, platform integrations, analytics depth, and ROI tracking capabilities.',
  'Data': 'AI data analysis and machine learning tools that extract actionable insights from spreadsheets, databases, and APIs without writing code. They handle everything from simple visualizations to predictive modeling and anomaly detection. We evaluate them on data source support, analysis accuracy, visualization quality, and collaboration features.'
};

const categoryEvalCriteria: Record<string, string[]> = {
  'Writing': ['Output quality & originality', 'Tone and style control', 'Template variety', 'Integration with CMS platforms'],
  'Image': ['Image resolution & quality', 'Style range & consistency', 'Commercial licensing', 'Editing & inpainting features'],
  'Video': ['Video quality & resolution', 'Avatar realism', 'Language & caption support', 'Export format options'],
  'Audio': ['Voice naturalness', 'Language coverage', 'Cloning accuracy', 'Commercial use licensing'],
  'Coding': ['Code accuracy', 'Language support breadth', 'IDE integrations', 'Codebase security'],
  'Productivity': ['Automation depth', 'App integrations', 'Ease of setup', 'Privacy & data handling'],
  'Marketing': ['Content quality', 'Platform integrations', 'A/B testing support', 'Analytics & ROI tracking'],
  'Data': ['Data source support', 'Analysis accuracy', 'Visualization options', 'Collaboration features'],
};

const description = categoryDescriptions[categoryName] || `Discover the best ${categoryName} AI tools. Compare features, pricing, and find the perfect tool for your needs.`;
const evalCriteria = categoryEvalCriteria[categoryName] || ['Feature set', 'Ease of use', 'Pricing value', 'Support quality'];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ai-tools-hq.com" },
    { "@type": "ListItem", "position": 2, "name": `${categoryName} Tools`, "item": `https://www.ai-tools-hq.com/category/${categoryName.toLowerCase()}` }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Best AI ${categoryName} Tools`,
  "numberOfItems": tools.length,
  "itemListElement": tools.slice(0, 10).map((tool, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": tool.name,
    "url": `https://www.ai-tools-hq.com/tools/${tool.slug}`
  }))
};
---

<Layout
  title={`Best AI ${categoryName} Tools 2026 — Reviewed & Compared | AI Tools HQ`}
  description={description}
  schemaType="itemList"
  tools={tools}
  listName={`Best AI ${categoryName} Tools`}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: categoryName, url: `/category/${categoryName.toLowerCase()}` }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <main class="category-page">
    <header class="category-header">
      <div class="breadcrumb">
        <a href="/">Home</a> / {categoryName} Tools
      </div>
      <h1>Best AI {categoryName} Tools</h1>
      <p>{description}</p>
      <div class="stats">
        <span>{tools.length} tools reviewed</span>
      </div>
    </header>

    <section class="eval-criteria">
      <h2>What We Look For</h2>
      <div class="criteria-grid">
        {evalCriteria.map(criterion => (
          <div class="criterion">
            <span class="criterion-icon">&#10003;</span>
            <span>{criterion}</span>
          </div>
        ))}
      </div>
    </section>

    <div class="pricing-filters">
      <span class="filter-label">Pricing:</span>
      <button class="pricing-btn active" data-pricing="all">All</button>
      <button class="pricing-btn" data-pricing="free">Free</button>
      <button class="pricing-btn" data-pricing="freemium">Freemium</button>
      <button class="pricing-btn" data-pricing="paid">Paid</button>
      <button class="pricing-btn" data-pricing="free trial">Free Trial</button>
    </div>

    <div class="tools-grid" id="tools-grid">
      {tools.map(tool => {
        const p = (tool.pricing || '').toLowerCase();
        let pricingKey = 'paid';
        if (p.includes('free trial')) pricingKey = 'free trial';
        else if (p === 'free' || p.startsWith('free (')) pricingKey = 'free';
        else if (p.includes('freemium')) pricingKey = 'freemium';
        else if (p.includes('free')) pricingKey = 'free';
        return (
          <div class="tool-wrapper" data-pricing={pricingKey}>
            <ToolCard tool={tool} />
          </div>
        );
      })}
    </div>

    {tools.length === 0 && (
      <div class="no-tools">
        <p>No tools found in this category yet. Check back soon!</p>
      </div>
    )}
  </main>
</Layout>

<style>
  .category-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 8rem 2rem 4rem;
  }

  .category-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, rgba(245, 166, 35, 0.15) 0%, rgba(255, 107, 53, 0.1) 100%);
    border: 1px solid rgba(245, 166, 35, 0.3);
    border-radius: 20px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .category-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 1rem;
    line-height: 1.7;
  }

  .stats {
    color: var(--accent-primary);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.5rem;
  }

  .breadcrumb {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .breadcrumb a {
    color: var(--accent-primary);
  }

  .eval-criteria {
    margin-bottom: 3rem;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
  }

  .eval-criteria h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .criteria-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .criterion {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .criterion-icon {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .pricing-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-right: 0.25rem;
  }

  .pricing-btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-subtle);
    background: transparent;
    border-radius: 50px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.3s var(--ease-out-expo);
    color: var(--text-secondary);
  }

  .pricing-btn:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-accent);
    color: var(--text-primary);
  }

  .pricing-btn.active {
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-color: var(--accent-primary);
  }

  .tool-wrapper {
    transition: opacity 0.3s, transform 0.3s;
  }

  .tool-wrapper.hidden {
    display: none;
  }

  .no-tools {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .category-page {
      padding: 7rem 1.5rem 3rem;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const pricingBtns = document.querySelectorAll('.pricing-btn');
  const toolWrappers = document.querySelectorAll('.tool-wrapper') as NodeListOf<HTMLElement>;

  pricingBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const pricing = (btn as HTMLElement).dataset.pricing || 'all';
      pricingBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      toolWrappers.forEach(wrapper => {
        const toolPricing = wrapper.dataset.pricing || '';
        if (pricing === 'all' || toolPricing === pricing) {
          wrapper.classList.remove('hidden');
        } else {
          wrapper.classList.add('hidden');
        }
      });
    });
  });
</script>
