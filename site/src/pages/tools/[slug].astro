---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getAllTools } from '../../lib/supabase';
import { getStaggeredDate, escapeHtml, splitBullets, safeJsonLd } from '../../lib/seo-utils';

export async function getStaticPaths() {
  const tools = await getAllTools();
  return tools
    .filter(tool => tool.slug)
    .map(tool => {
      const relatedTools = tools
        .filter(t => t.category === tool.category && t.slug !== tool.slug)
        .slice(0, 4);
      return {
        params: { slug: tool.slug },
        props: { tool, relatedTools }
      };
    });
}

const { tool, relatedTools } = Astro.props;

// Pre-parse bullet text (used in pros/cons list, verdict, and schema)
const toolPros = splitBullets(tool.pros);
const toolCons = splitBullets(tool.cons);

// Derive a "Best For" line from description (first sentence) + category
const bestForLine = tool.description?.split(/[.!?]/)[0]?.trim()
  || `${tool.category} workflows`;

// Safe HTML formatters
const safeFeatures = escapeHtml(tool.features)
  .replace(/•/g, '<div class="feature-item">•')
  .replace(/\n/g, '</div>');

const safeReview = escapeHtml(tool.review)
  .replace(/\n\n/g, '</p><p>')
  .replace(/^/, '<p>')
  .replace(/$/, '</p>');

const datePublished = getStaggeredDate(tool.slug);

// Schema.org markup for SEO
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "SoftwareApplication",
    "name": tool.name,
    "applicationCategory": "AI Tool",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "price": tool.pricing?.includes("Free") ? "0" : undefined,
      "priceCurrency": "USD"
    }
  },
  "author": {
    "@type": "Organization",
    "name": "AI Tools HQ",
    "url": "https://www.ai-tools-hq.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "AI Tools HQ",
    "url": "https://www.ai-tools-hq.com"
  },
  "datePublished": datePublished,
  "dateModified": new Date().toISOString().split('T')[0],
  "reviewBody": tool.review
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.ai-tools-hq.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": tool.category,
      "item": `https://www.ai-tools-hq.com/category/${tool.category.toLowerCase()}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": tool.name,
      "item": `https://www.ai-tools-hq.com/tools/${tool.slug}`
    }
  ]
};

// Build alternatives from related tools
const alternatives = relatedTools.slice(0, 2).map(t => t.name).join(', ') || 'See other tools in this category.';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is ${tool.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": tool.description
      }
    },
    {
      "@type": "Question",
      "name": `How much does ${tool.name} cost?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${tool.name} pricing: ${tool.pricing}`
      }
    },
    {
      "@type": "Question",
      "name": `What are the best alternatives to ${tool.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Popular alternatives include ${alternatives}.`
      }
    }
  ]
};

// Add UTM params to affiliate link (guard against missing/relative URLs)
let trackingAffiliateLink = tool.affiliateLink || '#';
try {
  const affiliateLinkWithUTM = new URL(tool.affiliateLink);
  affiliateLinkWithUTM.searchParams.set('ref', 'aitoolshq');
  affiliateLinkWithUTM.searchParams.set('utm_source', 'ai-tools-hq');
  affiliateLinkWithUTM.searchParams.set('utm_medium', 'tool-page');
  trackingAffiliateLink = affiliateLinkWithUTM.toString();
} catch { /* affiliateLink missing or not absolute — use as-is */ }
---

<Layout
  title={`${tool.name} Review 2026 — Features, Pricing & Alternatives | AI Tools HQ`}
  description={(tool.description?.length ?? 0) > 155 ? tool.description.slice(0, 152) + '...' : (tool.description ?? '')}
  ogType="article"
>
  <script type="application/ld+json" set:html={safeJsonLd(reviewSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(faqSchema)} />

  <main class="tool-page">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href={`/category/${tool.category.toLowerCase()}`}>{tool.category}</a> / {tool.name}
    </div>

    <header class="tool-header">
      <div class="header-content">
        <div class="header-badges">
          <span class="category-badge">{tool.category}</span>
          <span class="freshness-badge">Updated {new Date().toLocaleString('en-US', { month: 'long', year: 'numeric' })}</span>
        </div>
        <h1>{tool.name}</h1>
        <p class="tagline">{tool.description}</p>

        <div class="cta-buttons">
          <a href={trackingAffiliateLink} class="btn-primary btn-cta" target="_blank" rel="noopener sponsored">
            🚀 Try {tool.name} Free →
          </a>
          <a href={tool.website} class="btn-secondary" target="_blank" rel="noopener">
            Visit Website
          </a>
        </div>
      </div>

      <div class="quick-info">
        <div class="info-item">
          <span class="label">Pricing</span>
          <span class="value">{tool.pricing}</span>
        </div>
        <div class="info-item">
          <span class="label">Category</span>
          <span class="value">{tool.category}</span>
        </div>
        <div class="info-item">
          <span class="label">Best For</span>
          <span class="value">{bestForLine}</span>
        </div>
      </div>
    </header>

    <article class="review-content">
      <section class="features">
        <h2>Key Features</h2>
        <div class="feature-list" set:html={safeFeatures} />
      </section>

      <section class="faq-section">
        <h2>FAQ</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>What is {tool.name}?</h3>
            <p>{tool.description}</p>
          </div>
          <div class="faq-item">
            <h3>How much does {tool.name} cost?</h3>
            <p>{tool.name} pricing: {tool.pricing}</p>
          </div>
          <div class="faq-item">
            <h3>What are the best alternatives to {tool.name}?</h3>
            <p>Popular alternatives include {alternatives}. Check out our full directory for more options in this category.</p>
          </div>
        </div>
      </section>

      <div class="pros-cons">
        <section class="pros">
          <h2>✓ Pros</h2>
          <ul>
            {toolPros.map(pro => (
              <li>{pro}</li>
            ))}
          </ul>
        </section>

        <section class="cons">
          <h2>✗ Cons</h2>
          <ul>
            {toolCons.map(con => (
              <li>{con}</li>
            ))}
          </ul>
        </section>
      </div>

      <section class="full-review">
        <h2>Full Review</h2>
        <div class="review-text" set:html={safeReview} />
      </section>

      <section class="quick-facts">
        <h2>Quick Facts</h2>
        <dl class="facts-grid">
          <div class="fact">
            <dt>Category</dt>
            <dd>{tool.category}</dd>
          </div>
          <div class="fact">
            <dt>Pricing</dt>
            <dd>{tool.pricing}</dd>
          </div>
          <div class="fact">
            <dt>Best For</dt>
            <dd>{bestForLine}</dd>
          </div>
          <div class="fact">
            <dt>Website</dt>
            <dd><a href={tool.website} target="_blank" rel="noopener">{tool.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></dd>
          </div>
        </dl>
      </section>

      <section class="verdict">
        <h2>Our Verdict</h2>
        <div class="verdict-box">
          <p>
            <strong>{tool.name}</strong> stands out in the {tool.category.toLowerCase()} category
            {tool.pricing?.includes('Free') ? ' with a free tier that lets you get started immediately' : ` at ${tool.pricing}`}.
            {tool.pros ? ` Its key strengths include ${toolPros.slice(0, 2).map(p => p.toLowerCase()).join(' and ')}.` : ''}
            {tool.cons ? ` Keep in mind that ${toolCons.slice(0, 1).map(c => c.toLowerCase()).join('')}.` : ''}
          </p>
          <a href={trackingAffiliateLink} class="btn-primary btn-large" target="_blank" rel="noopener sponsored">
            Get Started with {tool.name} →
          </a>
        </div>
      </section>
      <section class="internal-links">
        <h2>Explore More</h2>
        <div class="links-grid">
          <a href={`/category/${tool.category.toLowerCase()}`} class="link-card">
            <span class="link-label">Category</span>
            <span class="link-title">All {tool.category} Tools</span>
          </a>
          {relatedTools.slice(0, 3).map(related => (
            <a href={`/tools/${related.slug}`} class="link-card">
              <span class="link-label">Compare with</span>
              <span class="link-title">{related.name}</span>
            </a>
          ))}
          <a href="/" class="link-card">
            <span class="link-label">Home</span>
            <span class="link-title">AI Tools HQ Directory</span>
          </a>
        </div>
      </section>
    </article>

    <aside class="sidebar">
      <div class="sticky-cta">
        <h3>Try {tool.name}</h3>
        <p class="sidebar-pricing">{tool.pricing}</p>
        <a href={trackingAffiliateLink} class="btn-primary sidebar-btn" target="_blank" rel="noopener sponsored">
          Start Free Trial →
        </a>
        <p class="sidebar-note">See if {tool.name} is right for you</p>
        <div class="sidebar-features">
          {toolPros.slice(0, 3).map(pro => (
            <div class="sidebar-feature">✓ {pro}</div>
          ))}
        </div>
      </div>
    </aside>

    {relatedTools.length > 0 && (
      <section class="related-tools">
        <h2>Related {tool.category} Tools</h2>
        <div class="related-grid">
          {relatedTools.map(related => (
            <ToolCard tool={related} />
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .tool-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
  }

  .breadcrumb {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .breadcrumb a {
    color: var(--accent-primary);
  }

  .tool-header {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
    color: white;
    padding: 3rem;
    border-radius: 16px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }

  .header-badges {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .category-badge {
    background: var(--white-20);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    display: inline-block;
  }

  .freshness-badge {
    background: var(--success-bg-strong);
    border: 1px solid var(--success-border-strong);
    color: #fff; /* ds-exception: white text on success bg, not --text-primary */
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    display: inline-block;
  }

  .btn-cta {
    font-size: 1rem;
    padding: 1rem 2rem;
    box-shadow: var(--shadow-md);
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn-primary, .btn-secondary {
    padding: 0.875rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.2s var(--ease-out-expo);
  }

  .btn-primary {
    background: #fff; /* ds-exception: white button on accent gradient header, no token for solid white bg */
    color: var(--accent-primary);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .btn-secondary {
    background: transparent;
    color: #fff; /* ds-exception: white text on accent gradient header */
    border: 2px solid var(--white-50);
  }

  .btn-secondary:hover {
    border-color: #fff; /* ds-exception: white border on accent gradient, no solid white token */
  }

  .quick-info {
    background: var(--white-10);
    padding: 1.5rem;
    border-radius: 12px;
  }

  .info-item {
    margin-bottom: 1rem;
  }

  .info-item:last-child {
    margin-bottom: 0;
  }

  .label {
    display: block;
    font-size: 0.8rem;
    opacity: 0.7;
    margin-bottom: 0.25rem;
  }

  .value {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .review-content {
    grid-column: 1;
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .features {
    margin-bottom: 2rem;
  }

  .feature-item {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .faq-section {
    margin-bottom: 3rem;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
  }

  .faq-section h2 {
    margin-top: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .faq-item {
    padding: 1rem 0;
  }

  .faq-item h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .faq-item p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .pros-cons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .pros, .cons {
    padding: 1.5rem;
    border-radius: 12px;
  }

  .pros {
    background: var(--success-bg);
    border: 1px solid var(--success-border);
  }

  .cons {
    background: var(--error-bg);
    border: 1px solid var(--error-border);
  }

  .pros h2 {
    color: var(--success);
  }

  .cons h2 {
    color: var(--error);
  }

  .pros ul, .cons ul {
    list-style: none;
    padding: 0;
  }

  .pros li, .cons li {
    padding: 0.5rem 0;
  }

  .full-review {
    margin-bottom: 2rem;
  }

  .review-text p {
    margin-bottom: 1rem;
    line-height: 1.8;
  }

  .verdict-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 2rem;
    border-radius: 12px;
    text-align: center;
  }

  .verdict-box p {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .btn-large {
    display: inline-block;
    padding: 1rem 2rem;
    font-size: 1.1rem;
    background: var(--accent-primary);
    color: #fff; /* ds-exception: white text on accent bg, not --text-primary */
  }

  .sidebar {
    grid-column: 2;
  }

  .sticky-cta {
    position: sticky;
    top: 100px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 1.5rem;
    border-radius: 12px;
    text-align: center;
  }

  .sticky-cta h3 {
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-size: 1.25rem;
  }

  .sidebar-pricing {
    color: var(--accent-primary);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .sidebar-btn {
    display: block;
    background: var(--accent-primary);
    color: #fff; /* ds-exception: white text on accent bg */
    padding: 0.875rem;
    text-align: center;
    font-size: 1rem;
    border-radius: 8px;
    box-shadow: var(--shadow-accent);
    transition: all 0.2s var(--ease-out-expo);
  }

  .sidebar-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-accent-lg);
  }

  .sidebar-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .sidebar-features {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    margin-top: 0.5rem;
  }

  .sidebar-feature {
    font-size: 0.85rem;
    color: var(--success);
    padding: 0.3rem 0;
  }

  .quick-facts {
    margin-bottom: 2rem;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0;
  }

  .fact {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1rem;
  }

  .fact dt {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .fact dd {
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .fact dd a {
    color: var(--accent-primary);
  }

  .internal-links {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .link-card {
    display: block;
    padding: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    transition: all 0.2s var(--ease-out-expo);
  }

  .link-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  .link-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .link-title {
    display: block;
    font-weight: 600;
    color: var(--accent-primary);
    font-size: 0.95rem;
  }

  .related-tools {
    grid-column: 1 / -1;
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-subtle);
  }

  .related-tools h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .tool-page {
      grid-template-columns: 1fr;
    }

    .tool-header {
      grid-template-columns: 1fr;
    }

    .pros-cons {
      grid-template-columns: 1fr;
    }

    .sidebar {
      display: none;
    }
  }
</style>
