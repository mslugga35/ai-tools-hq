---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import ExitIntentPopup from '../../components/ExitIntentPopup.astro';
import { getAllTools } from '../../lib/supabase';
import { getStaggeredDate, escapeHtml, splitBullets, safeJsonLd } from '../../lib/seo-utils';

export async function getStaticPaths() {
  const tools = await getAllTools();
  return tools
    .filter(tool => tool.slug)
    .map(tool => {
      const relatedTools = tools
        .filter(t => t.category === tool.category && t.slug !== tool.slug)
        .slice(0, 4);
      return {
        params: { slug: tool.slug },
        props: { tool, relatedTools }
      };
    });
}

const { tool, relatedTools } = Astro.props;

// Upgrade affiliate link: homepage → pricing/trial page + sub1=tool-{slug} attribution
const buildToolLink = (affiliateLink: string, slug: string): string => {
  if (!affiliateLink) return '#';
  let url = affiliateLink
    .replace('https://synthesia.io?', 'https://synthesia.io/pricing?')
    .replace('https://baremetrics.com/?', 'https://baremetrics.com/pricing?')
    .replace('https://www.signwell.com/?', 'https://app.signwell.com/accounts/sign-up?')
    .replace('https://emailoctopus.com/?', 'https://emailoctopus.com/pricing?')
    .replace('https://outseta.com/?', 'https://outseta.com/pricing?')
    .replace('https://www.heygen.com?', 'https://www.heygen.com/pricing?')
    .replace('https://www.make.com?', 'https://www.make.com/en/register?')
    .replace('https://www.descript.com?', 'https://www.descript.com/pricing?');
  if (!url.includes('sub1=')) {
    url += (url.includes('?') ? '&' : '?') + `sub1=tool-${slug}`;
  }
  return url;
};

const toolLink = buildToolLink(tool.affiliateLink, tool.slug);

// Pre-parse bullet text (used in pros/cons list, verdict, and schema)
const toolPros = splitBullets(tool.pros);
const toolCons = splitBullets(tool.cons);

// Derive a "Best For" line from description (first sentence) + category
const bestForLine = tool.description?.split(/[.!?]/)[0]?.trim()
  || `${tool.category} workflows`;

// Safe HTML formatters
const safeFeatures = escapeHtml(tool.features)
  .replace(/•/g, '<div class="feature-item">•')
  .replace(/\n/g, '</div>');

const safeReview = escapeHtml(tool.review)
  .replace(/\n\n/g, '</p><p>')
  .replace(/^/, '<p>')
  .replace(/$/, '</p>');

const datePublished = getStaggeredDate(tool.slug);
const dateModified = tool.updated_at
  ? new Date(tool.updated_at).toISOString().split('T')[0]
  : datePublished;

// Schema.org markup for SEO
const toolPageUrl = `https://www.ai-tools-hq.com/tools/${tool.slug}`;

const appCategoryMap: Record<string, string> = {
  'writing': 'BusinessApplication',
  'image': 'MultimediaApplication',
  'video': 'MultimediaApplication',
  'audio': 'MultimediaApplication',
  'coding': 'DeveloperApplication',
  'productivity': 'BusinessApplication',
  'marketing': 'BusinessApplication',
  'data': 'BusinessApplication',
  'research': 'EducationalApplication',
  'chatbot': 'UtilitiesApplication',
  'automation': 'UtilitiesApplication',
  'design': 'MultimediaApplication',
  'seo': 'BusinessApplication',
  'customer support': 'BusinessApplication',
  'hr': 'BusinessApplication',
  'sales': 'BusinessApplication',
  'finance': 'FinanceApplication',
  'education': 'EducationalApplication',
  'social media': 'BusinessApplication',
};

const appCategory = appCategoryMap[tool.category?.toLowerCase() || ''] || 'BusinessApplication';
const isFree = tool.pricing?.toLowerCase().includes('free');
const priceMatch = tool.pricing?.match(/\$(\d+(?:\.\d{2})?)/);
const numericPrice = priceMatch ? priceMatch[1] : undefined;
const toolFeatures = splitBullets(tool.features);

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${toolPageUrl}#software`,
  "name": tool.name,
  "description": tool.description,
  "url": tool.website,
  "applicationCategory": appCategory,
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": isFree ? "0" : (numericPrice || undefined),
    "priceCurrency": "USD",
    "availability": "https://schema.org/OnlineOnly"
  },
  ...(tool.rating && tool.reviewCount ? {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": String(tool.rating),
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": tool.reviewCount
    }
  } : {}),
  ...(toolFeatures.length > 0 ? { "featureList": toolFeatures.join(', ') } : {}),
  "datePublished": datePublished
};

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "SoftwareApplication",
    "@id": `${toolPageUrl}#software`,
    "name": tool.name
  },
  "author": {
    "@type": "Organization",
    "name": "AI Tools HQ",
    "url": "https://www.ai-tools-hq.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "AI Tools HQ",
    "url": "https://www.ai-tools-hq.com"
  },
  "datePublished": datePublished,
  "dateModified": dateModified,
  "reviewBody": tool.review
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.ai-tools-hq.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": tool.category,
      "item": `https://www.ai-tools-hq.com/category/${tool.category.toLowerCase()}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": tool.name,
      "item": `https://www.ai-tools-hq.com/tools/${tool.slug}`
    }
  ]
};

const alternativesText = relatedTools.length > 0
  ? `Popular alternatives to ${tool.name} include ${relatedTools.slice(0, 3).map(t => t.name).join(', ')}.`
  : `For alternatives to ${tool.name}, explore our ${tool.category} tools directory.`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is ${tool.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": tool.description
      }
    },
    {
      "@type": "Question",
      "name": `How much does ${tool.name} cost?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${tool.name} pricing: ${tool.pricing}`
      }
    },
    {
      "@type": "Question",
      "name": `What are alternatives to ${tool.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": alternativesText
      }
    }
  ]
};
---

<Layout
  title={`${tool.name} Review 2026 — Features, Pricing & Alternatives | AI Tools HQ`}
  description={(tool.description?.length ?? 0) > 155 ? tool.description.slice(0, 152) + '...' : (tool.description ?? '')}
  ogType="article"
>
  <script type="application/ld+json" set:html={safeJsonLd(softwareAppSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(reviewSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(faqSchema)} />

  <main class="tool-page">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href={`/category/${tool.category.toLowerCase()}`}>{tool.category}</a> / {tool.name}
    </div>

    <header class="tool-header">
      <div class="header-content">
        <div class="header-badges">
          <span class="category-badge">{tool.category}</span>
          <span class="freshness-badge">Updated {tool.updated_at ? new Date(tool.updated_at).toLocaleString('en-US', { month: 'long', year: 'numeric' }) : new Date().toLocaleString('en-US', { month: 'long', year: 'numeric' })}</span>
        </div>
        <h1>{tool.name}</h1>
        <p class="tagline">{tool.description}</p>

        <div class="cta-buttons">
          {toolLink !== '#' ? (
            <a href={toolLink} class="btn-primary btn-cta" target="_blank" rel="noopener sponsored">
              🚀 Try {tool.name} Free →
            </a>
          ) : (
            <a href={tool.website} class="btn-primary btn-cta" target="_blank" rel="noopener">
              🚀 Visit {tool.name} →
            </a>
          )}
          <a href={tool.website} class="btn-secondary" target="_blank" rel="noopener">
            Visit Website
          </a>
        </div>
        {toolLink !== '#' && (
          <p class="ftc-note">Affiliate link — we may earn a commission at no cost to you. <a href="/about#affiliate-disclosure">Learn more</a></p>
        )}
      </div>

      <div class="quick-info">
        <div class="info-item">
          <span class="label">Pricing</span>
          <span class="value">{tool.pricing}</span>
        </div>
        <div class="info-item">
          <span class="label">Category</span>
          <span class="value">{tool.category}</span>
        </div>
        <div class="info-item">
          <span class="label">Best For</span>
          <span class="value">{bestForLine}</span>
        </div>
      </div>
    </header>

    <article class="review-content">
      <section class="features">
        <h2>Key Features</h2>
        <div class="feature-list" set:html={safeFeatures} />
      </section>

      <div class="pros-cons">
        <section class="pros">
          <h2>✓ Pros</h2>
          <ul>
            {toolPros.map(pro => (
              <li>{pro}</li>
            ))}
          </ul>
        </section>

        <section class="cons">
          <h2>✗ Cons</h2>
          <ul>
            {toolCons.map(con => (
              <li>{con}</li>
            ))}
          </ul>
        </section>
      </div>

      <section class="full-review">
        <h2>Full Review</h2>
        <div class="review-text" set:html={safeReview} />
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
          <details class="faq-item">
            <summary>What is {tool.name}?</summary>
            <p>{tool.description}</p>
          </details>
          <details class="faq-item">
            <summary>How much does {tool.name} cost?</summary>
            <p>{tool.name} pricing: {tool.pricing}</p>
          </details>
          <details class="faq-item">
            <summary>What are alternatives to {tool.name}?</summary>
            <p>
              {relatedTools.length > 0 ? (
                <>Popular alternatives include <a href={`/tools/${relatedTools[0].slug}`}>{relatedTools[0].name}</a>
                {relatedTools.length > 1 && <>, <a href={`/tools/${relatedTools[1].slug}`}>{relatedTools[1].name}</a></>}
                {relatedTools.length > 2 && <>, and <a href={`/tools/${relatedTools[2].slug}`}>{relatedTools[2].name}</a></>}. See our full <a href={`/alternatives/${tool.slug}`}>{tool.name} alternatives guide</a> or explore the <a href={`/category/${tool.category.toLowerCase()}`}>{tool.category}</a> tools directory.</>
              ) : (
                <>See our <a href={`/alternatives/${tool.slug}`}>{tool.name} alternatives guide</a> or explore the <a href={`/category/${tool.category.toLowerCase()}`}>{tool.category}</a> tools directory.</>
              )}
            </p>
          </details>
        </div>
      </section>

      <section class="quick-facts">
        <h2>Quick Facts</h2>
        <dl class="facts-grid">
          <div class="fact">
            <dt>Category</dt>
            <dd>{tool.category}</dd>
          </div>
          <div class="fact">
            <dt>Pricing</dt>
            <dd>{tool.pricing}</dd>
          </div>
          <div class="fact">
            <dt>Best For</dt>
            <dd>{bestForLine}</dd>
          </div>
          <div class="fact">
            <dt>Website</dt>
            <dd><a href={tool.website} target="_blank" rel="noopener">{tool.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></dd>
          </div>
        </dl>
      </section>

      <section class="verdict">
        <h2>Our Verdict</h2>
        <div class="verdict-box">
          <p>
            <strong>{tool.name}</strong> stands out in the {tool.category.toLowerCase()} category
            {tool.pricing?.includes('Free') ? ' with a free tier that lets you get started immediately' : ` at ${tool.pricing}`}.
            {tool.pros ? ` Its key strengths include ${toolPros.slice(0, 2).map(p => p.toLowerCase()).join(' and ')}.` : ''}
            {tool.cons ? ` Keep in mind that ${toolCons.slice(0, 1).map(c => c.toLowerCase()).join('')}.` : ''}
          </p>
          {toolLink !== '#' ? (
            <a href={toolLink} class="btn-primary btn-large" target="_blank" rel="noopener sponsored">
              Get Started with {tool.name} →
            </a>
          ) : (
            <a href={tool.website} class="btn-primary btn-large" target="_blank" rel="noopener">
              Visit {tool.name} →
            </a>
          )}
        </div>
      </section>
      {relatedTools.length > 0 && (
        <section class="comparison-table">
          <h2>{tool.name} vs {relatedTools[0].name}: Quick Comparison</h2>
          <div class="compare-wrapper">
            <table class="compare-grid">
              <thead>
                <tr>
                  <th class="compare-feature-col"></th>
                  <th class="compare-tool-col compare-winner">
                    <span class="compare-badge">Our Pick</span>
                    {tool.name}
                  </th>
                  <th class="compare-tool-col">
                    {relatedTools[0].name}
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Pricing</td>
                  <td class="compare-winner">{tool.pricing}</td>
                  <td>{relatedTools[0].pricing}</td>
                </tr>
                {toolPros.slice(0, 3).map(pro => (
                  <tr>
                    <td>{pro.length > 50 ? pro.slice(0, 47) + '...' : pro}</td>
                    <td class="compare-winner compare-check">✓</td>
                    <td class="compare-dash">—</td>
                  </tr>
                ))}
                <tr>
                  <td>Our Rating</td>
                  <td class="compare-winner">⭐⭐⭐⭐⭐</td>
                  <td><a href={`/tools/${relatedTools[0].slug}`}>See review →</a></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="compare-cta">
            {toolLink !== '#' ? (
              <a href={toolLink} class="btn-primary btn-large" target="_blank" rel="noopener sponsored">
                Try {tool.name} Free →
              </a>
            ) : (
              <a href={tool.website} class="btn-primary btn-large" target="_blank" rel="noopener">
                Visit {tool.name} →
              </a>
            )}
            <a href={`/tools/${relatedTools[0].slug}`} class="btn-secondary compare-alt-link">
              Read {relatedTools[0].name} Review
            </a>
          </div>
        </section>
      )}

      <section class="internal-links">
        <h2>Explore More</h2>
        <div class="links-grid">
          <a href={`/category/${tool.category.toLowerCase()}`} class="link-card">
            <span class="link-label">Category</span>
            <span class="link-title">All {tool.category} Tools</span>
          </a>
          <a href={`/alternatives/${tool.slug}`} class="link-card">
            <span class="link-label">Looking for options?</span>
            <span class="link-title">{tool.name} Alternatives</span>
          </a>
          {relatedTools.slice(0, 2).map(related => (
            <a href={`/tools/${related.slug}`} class="link-card">
              <span class="link-label">Similar tool</span>
              <span class="link-title">{related.name} Review</span>
            </a>
          ))}
          {relatedTools.length > 0 && (
            <a href={`/compare/${tool.slug}/${relatedTools[0].slug}`} class="link-card">
              <span class="link-label">Head-to-head</span>
              <span class="link-title">{tool.name} vs {relatedTools[0].name}</span>
            </a>
          )}
          <a href={`/best/ai-${tool.category.toLowerCase()}-tools`} class="link-card">
            <span class="link-label">Rankings</span>
            <span class="link-title">Best {tool.category} AI Tools</span>
          </a>
          <a href="/" class="link-card">
            <span class="link-label">Home</span>
            <span class="link-title">AI Tools HQ Directory</span>
          </a>
        </div>
      </section>
    </article>

    <aside class="sidebar">
      <div class="sticky-cta">
        <h3>Try {tool.name}</h3>
        <p class="sidebar-pricing">{tool.pricing}</p>
        {toolLink !== '#' ? (
          <a href={toolLink} class="btn-primary sidebar-btn" target="_blank" rel="noopener sponsored">
            Start Free Trial →
          </a>
        ) : (
          <a href={tool.website} class="btn-primary sidebar-btn" target="_blank" rel="noopener">
            Visit Website →
          </a>
        )}
        <p class="sidebar-note">See if {tool.name} is right for you</p>
        <div class="sidebar-features">
          {toolPros.slice(0, 3).map(pro => (
            <div class="sidebar-feature">✓ {pro}</div>
          ))}
        </div>
      </div>

      <div class="sponsor-cta">
        <p class="sponsor-label">Are you the maker?</p>
        <p class="sponsor-text">Get a featured listing, verified badge, and newsletter mention. Starting at $49/mo.</p>
        <a href="/advertise" class="sponsor-btn">Claim Your Listing →</a>
      </div>

      {tool.category === 'Audio' && tool.slug !== 'elevenlabs' && (
        <div class="affiliate-pick">
          <p class="aff-label">Top Pick — Audio AI</p>
          <strong class="aff-name">ElevenLabs</strong>
          <p class="aff-desc">Most realistic AI voices. Powers 1M+ creators worldwide.</p>
          <a href={`https://try.elevenlabs.io/f4il4v3cm496?sub1=sidebar-${tool.slug}`} class="aff-btn" target="_blank" rel="noopener sponsored">
            Try ElevenLabs Free →
          </a>
        </div>
      )}
      {tool.category === 'Video' && tool.slug !== 'synthesia' && (
        <div class="affiliate-pick">
          <p class="aff-label">Top Pick — Video AI</p>
          <strong class="aff-name">Synthesia</strong>
          <p class="aff-desc">Create professional AI avatar videos in minutes, no camera needed.</p>
          <a href={`https://synthesia.io/pricing?via=matt-morales&sub1=sidebar-${tool.slug}`} class="aff-btn" target="_blank" rel="noopener sponsored">
            Try Synthesia Free →
          </a>
        </div>
      )}
      {tool.category === 'Marketing' && tool.slug !== 'emailoctopus' && (
        <div class="affiliate-pick">
          <p class="aff-label">Top Pick — Email Marketing</p>
          <strong class="aff-name">EmailOctopus</strong>
          <p class="aff-desc">Affordable email marketing that scales. 10K subscribers free.</p>
          <a href={`https://emailoctopus.com/pricing?ref=matt&sub1=sidebar-${tool.slug}`} class="aff-btn" target="_blank" rel="noopener sponsored">
            Start Free with EmailOctopus →
          </a>
        </div>
      )}
      {tool.category === 'Data' && tool.slug !== 'baremetrics' && (
        <div class="affiliate-pick">
          <p class="aff-label">Top Pick — Subscription Analytics</p>
          <strong class="aff-name">Baremetrics</strong>
          <p class="aff-desc">MRR, churn, LTV at a glance. Trusted by 1,000+ SaaS teams.</p>
          <a href={`https://baremetrics.com/pricing?via=matt&sub1=sidebar-${tool.slug}`} class="aff-btn" target="_blank" rel="noopener sponsored">
            Try Baremetrics Free →
          </a>
        </div>
      )}
      {tool.category === 'Security' && tool.slug !== 'signwell' && (
        <div class="affiliate-pick">
          <p class="aff-label">Top Pick — Security</p>
          <strong class="aff-name">SignWell</strong>
          <p class="aff-desc">Beautiful e-signatures with tracking and templates. Trusted by 50K+ businesses.</p>
          <a href={`https://app.signwell.com/accounts/sign-up?via=matt-morales&sub1=sidebar-${tool.slug}`} class="aff-btn" target="_blank" rel="noopener sponsored">
            Try SignWell Free →
          </a>
        </div>
      )}
      {tool.category === 'Business' && tool.slug !== 'outseta' && (
        <div class="affiliate-pick">
          <p class="aff-label">Top Pick — Business</p>
          <strong class="aff-name">Outseta</strong>
          <p class="aff-desc">All-in-one membership platform: billing, auth, CRM, and email in one tool.</p>
          <a href={`https://outseta.com/pricing?via=matt-morales&sub1=sidebar-${tool.slug}`} class="aff-btn" target="_blank" rel="noopener sponsored">
            Try Outseta Free →
          </a>
        </div>
      )}
      {!['Audio', 'Video', 'Marketing', 'Data', 'Security', 'Business'].includes(tool.category) && (
        <div class="affiliate-pick affiliate-pick-deals">
          <p class="aff-label">This Week's Deals</p>
          <strong class="aff-name">AI Tool Offers</strong>
          <p class="aff-desc">Free trials and special offers on top {tool.category} tools — updated monthly.</p>
          <a href="/deals" class="aff-btn">Browse Deals →</a>
        </div>
      )}
    </aside>

    {relatedTools.length > 0 && (
      <section class="related-tools">
        <h2>Related {tool.category} Tools</h2>
        <div class="related-grid">
          {relatedTools.map(related => (
            <ToolCard tool={related} />
          ))}
        </div>
      </section>
    )}

    <div class="newsletter-wrap">
      <Newsletter />
    </div>
  </main>
  <ExitIntentPopup />
</Layout>

<style>
  .tool-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
  }

  .newsletter-wrap {
    grid-column: 1 / -1;
  }

  .breadcrumb {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .breadcrumb a {
    color: var(--accent-primary);
  }

  .tool-header {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
    color: white;
    padding: 3rem;
    border-radius: 16px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }

  .header-badges {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .category-badge {
    background: var(--white-20);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    display: inline-block;
  }

  .freshness-badge {
    background: var(--success-bg-strong);
    border: 1px solid var(--success-border-strong);
    color: #fff; /* ds-exception: white text on success bg, not --text-primary */
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    display: inline-block;
  }

  .btn-cta {
    font-size: 1rem;
    padding: 1rem 2rem;
    box-shadow: var(--shadow-md);
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
  }

  .ftc-note {
    font-size: 0.75rem;
    opacity: 0.65;
    margin-top: 0.5rem;
