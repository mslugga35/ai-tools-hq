---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getAllTools, getCategories } from '../../lib/supabase';

const tools = await getAllTools();
const categories = await getCategories();
---

<Layout
  title={`All AI Tools - ${tools.length}+ Tools Reviewed | AI Tools HQ`}
  description={`Browse our complete directory of ${tools.length}+ AI tools. Compare features, pricing, and find the perfect AI tool for writing, images, video, coding, and more.`}
>
  <main class="tools-page">
    <header class="page-header">
      <h1>All AI Tools</h1>
      <p>{tools.length} tools reviewed and compared</p>
    </header>

    <div class="search-bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
      </svg>
      <input type="search" id="tools-search" placeholder="Search tools..." />
    </div>

    <div class="filters">
      <button class="filter-btn active" data-category="all">All</button>
      {categories.map(cat => (
        <button class="filter-btn" data-category={cat.toLowerCase()}>{cat}</button>
      ))}
    </div>

    <div class="tools-grid" id="tools-grid">
      {tools.map(tool => (
        <div class="tool-wrapper" data-category={tool.category.toLowerCase()} data-name={tool.name.toLowerCase()}>
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .tools-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 8rem 2rem 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .page-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .search-bar {
    display: flex;
    align-items: center;
    max-width: 500px;
    margin: 0 auto 1.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 50px;
    gap: 0.75rem;
    transition: all 0.3s ease;
  }

  .search-bar:focus-within {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }

  .search-bar svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .search-bar input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .search-bar input::placeholder {
    color: var(--text-muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 3rem;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
  }

  .filter-btn {
    padding: 0.6rem 1.25rem;
    border: none;
    background: transparent;
    border-radius: 50px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s var(--ease-out-expo);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .filter-btn:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-accent);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-color: var(--accent-primary);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.5rem;
  }

  .tool-wrapper {
    transition: opacity 0.3s, transform 0.3s;
  }

  .tool-wrapper.hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .tools-page {
      padding: 7rem 1.5rem 3rem;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const toolWrappers = document.querySelectorAll('.tool-wrapper') as NodeListOf<HTMLElement>;
  const searchInput = document.getElementById('tools-search') as HTMLInputElement;

  // Handle URL search query
  const urlParams = new URLSearchParams(window.location.search);
  const searchQuery = urlParams.get('q')?.toLowerCase() || '';

  function filterTools(category: string, query: string) {
    toolWrappers.forEach(wrapper => {
      const toolCategory = wrapper.dataset.category || '';
      const toolName = wrapper.dataset.name || '';

      const matchesCategory = category === 'all' || toolCategory === category;
      const matchesSearch = !query || toolName.includes(query);

      if (matchesCategory && matchesSearch) {
        wrapper.classList.remove('hidden');
      } else {
        wrapper.classList.add('hidden');
      }
    });
  }

  // Initialize with search query from URL
  if (searchQuery && searchInput) {
    searchInput.value = searchQuery;
    filterTools('all', searchQuery);
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = (btn as HTMLElement).dataset.category || 'all';

      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const query = searchInput?.value.toLowerCase() || '';
      filterTools(category, query);
    });
  });

  searchInput?.addEventListener('input', () => {
    const activeBtn = document.querySelector('.filter-btn.active') as HTMLElement;
    const category = activeBtn?.dataset.category || 'all';
    filterTools(category, searchInput.value.toLowerCase());
  });
</script>

