---
import Layout from '../layouts/Layout.astro';
import { getAllTools } from '../lib/supabase';

const allTools = await getAllTools();
const affiliateTools = allTools.filter(t => t.affiliateLink && t.affiliateLink.trim().length > 0);

// Commission metadata for known affiliate programs
const commissionMeta: Record<string, { rate: string; type: string; highlight?: string }> = {
  'synthesia': { rate: 'Commission', type: 'Affiliate', highlight: 'AI Video' },
  'elevenlabs': { rate: 'Commission', type: 'Affiliate', highlight: 'Voice AI' },
  'emailoctopus': { rate: 'Commission', type: 'Affiliate', highlight: 'Email Marketing' },
  'signwell': { rate: 'Commission', type: 'Affiliate', highlight: 'E-Signatures' },
  'outseta': { rate: 'Commission', type: 'Affiliate', highlight: 'All-in-One' },
  'baremetrics': { rate: 'Commission', type: 'Affiliate', highlight: 'Analytics' },
  'zaap': { rate: 'Commission', type: 'Affiliate', highlight: 'Link Management' },
};

const currentMonth = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ai-tools-hq.com" },
    { "@type": "ListItem", "position": 2, "name": "AI Tool Deals", "item": "https://www.ai-tools-hq.com/deals" }
  ]
};

function getDomain(url: string): string {
  try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}

function addDealTracking(url: string, slug: string, placement: string = 'row'): string {
  if (!url) return '#';
  const sep = url.includes('?') ? '&' : '?';
  return url + sep + `sub1=deals-${placement}-${slug}`;
}

const categoryOrder = ['Writing', 'Video', 'Audio', 'Coding', 'Marketing', 'Productivity', 'Data', 'Image'];

const toolsByCategory = categoryOrder.reduce((acc, cat) => {
  const catTools = affiliateTools.filter(t => t.category === cat);
  if (catTools.length > 0) acc[cat] = catTools;
  return acc;
}, {} as Record<string, typeof affiliateTools>);

const uncategorized = affiliateTools.filter(t => !categoryOrder.includes(t.category));
if (uncategorized.length > 0) toolsByCategory['Other'] = uncategorized;

const categoryIcons: Record<string, string> = {
  'Writing': '✍️', 'Image': '🎨', 'Video': '🎬', 'Audio': '🎵',
  'Coding': '💻', 'Productivity': '⚡', 'Marketing': '📈', 'Data': '📊', 'Other': '🤖'
};
---

<Layout
  title={`AI Tool Deals & Affiliate Offers — ${affiliateTools.length} Tools | AI Tools HQ`}
  description={`Save on the best AI tools. ${affiliateTools.length} verified deals on AI software for creators, developers, and teams. Updated ${currentMonth}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="deals-page">
    <!-- Header -->
    <header class="deals-header">
      <div class="deals-badge">
        <span class="badge-dot"></span>
        <span>Updated {currentMonth}</span>
      </div>
      <h1>AI Tool <em>Deals</em></h1>
      <p class="deals-subtitle">
        {affiliateTools.length} verified tools with special offers. We earn a commission at no extra cost to you — it's how we keep the lights on.
      </p>
      <div class="trust-bar">
        <span>✅ Honest reviews</span>
        <span>✅ No extra cost to you</span>
        <span>✅ Updated monthly</span>
      </div>
    </header>

    <!-- Top picks strip -->
    <section class="top-picks">
      <h2 class="section-label">Our Top Picks</h2>
      <div class="picks-grid">
        {affiliateTools.slice(0, 3).map(tool => {
          const domain = getDomain(tool.website);
          const logoUrl = domain ? `https://img.logo.dev/${domain}?token=pk_VAZ6EX0OSROxLyDRLvERhg` : '';
          return (
            <div class="pick-card">
              <div class="pick-header">
                {logoUrl && (
                  <img src={logoUrl} alt={`${tool.name} logo`} width="40" height="40" loading="lazy"
                    onerror="this.style.display='none'" />
                )}
                <div>
                  <div class="pick-name">{tool.name}</div>
                  <div class="pick-category">{categoryIcons[tool.category] || '🤖'} {tool.category}</div>
                </div>
              </div>
              <p class="pick-desc">{tool.description?.slice(0, 80)}...</p>
              <div class="pick-actions">
                <a href={`/tools/${tool.slug}`} class="btn-sm-outline">Review</a>
                <a href={addDealTracking(tool.affiliateLink, tool.slug, 'top')} class="btn-sm-primary" target="_blank" rel="noopener sponsored">
                  Get Deal →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- All deals by category -->
    {Object.entries(toolsByCategory).map(([cat, tools]) => (
      <section class="category-section">
        <h2 class="cat-heading">
          <span class="cat-icon">{categoryIcons[cat] || '🤖'}</span>
          {cat}
          <span class="cat-count">{tools.length} {tools.length === 1 ? 'deal' : 'deals'}</span>
        </h2>

        <div class="deals-list">
          {tools.map(tool => {
            const domain = getDomain(tool.website);
            const logoUrl = domain ? `https://img.logo.dev/${domain}?token=pk_VAZ6EX0OSROxLyDRLvERhg` : '';
            const meta = commissionMeta[tool.slug] || null;
            return (
              <div class="deal-row">
                <div class="deal-logo">
                  {logoUrl ? (
                    <img src={logoUrl} alt={`${tool.name} logo`} width="44" height="44" loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                  ) : null}
                  <div class="deal-logo-fallback" style={logoUrl ? 'display:none' : ''}>
                    {tool.name.charAt(0).toUpperCase()}
                  </div>
                </div>

                <div class="deal-info">
                  <div class="deal-name-row">
                    <h3>
                      <a href={`/tools/${tool.slug}`}>{tool.name}</a>
                    </h3>
                    {meta?.highlight && <span class="highlight-badge">{meta.highlight}</span>}
                  </div>
                  <p class="deal-desc">{tool.description?.slice(0, 120)}{(tool.description?.length ?? 0) > 120 ? '...' : ''}</p>
                  <div class="deal-meta">
                    <span class="pricing-tag">{tool.pricing}</span>
                  </div>
                </div>

                <div class="deal-cta">
                  <a href={addDealTracking(tool.affiliateLink, tool.slug)} class="btn-deal" target="_blank" rel="noopener sponsored">
                    Get Deal
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15 3 21 3 21 9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </a>
                  <a href={`/tools/${tool.slug}`} class="review-link">Read review</a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <!-- Disclosure -->
    <section class="disclosure">
      <p>
        <strong>Affiliate Disclosure:</strong> AI Tools HQ earns a commission when you purchase through our links.
        You pay the same price — commissions come from the vendor. We only list tools we've actually reviewed.
      </p>
    </section>

    <!-- CTA to full directory -->
    <section class="bottom-cta">
      <h2>Don't see what you need?</h2>
      <p>Browse our full directory of {allTools.length}+ AI tools with honest reviews.</p>
      <a href="/tools" class="btn-primary-lg">Explore All Tools →</a>
    </section>
  </main>
</Layout>

<style>
  .deals-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 8rem 2rem 4rem;
  }

  /* Header */
  .deals-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .deals-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: var(--white-05);
    border: 1px solid var(--white-10);
    border-radius: 50px;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .deals-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .deals-header h1 em {
    color: var(--accent-primary);
    font-style: normal;
  }

  .deals-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto 1.5rem;
    line-height: 1.7;
  }

  .trust-bar {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Top picks */
  .section-label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .picks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .pick-card {
    background: var(--white-02);
    border: 1px solid var(--white-10);
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.3s var(--ease-out-expo);
  }

  .pick-card:hover {
    background: var(--white-04);
    transform: translateY(-4px);
  }

  .pick-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .pick-header img {
    border-radius: 10px;
    object-fit: contain;
    background: var(--white-10);
  }

  .pick-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .pick-category {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .pick-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .pick-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-sm-outline {
    flex: 1;
    text-align: center;
    padding: 0.5rem 0.75rem;
    background: var(--white-05);
    border: 1px solid var(--white-10);
    border-radius: 8px;
    font-size: 0.8rem;
    color: var(--text-primary);
    transition: all 0.2s;
  }

  .btn-sm-outline:hover {
    background: var(--white-10);
  }

  .btn-sm-primary {
    flex: 1;
    text-align: center;
    padding: 0.5rem 0.75rem;
    background: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    border-radius: 8px;
    font-size: 0.8rem;
    color: var(--bg-primary);
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn-sm-primary:hover {
    filter: brightness(1.1);
  }

  /* Category sections */
  .top-picks {
    margin-bottom: 2rem;
  }

  .category-section {
    margin-bottom: 3rem;
  }

  .cat-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cat-icon {
    font-size: 1.2rem;
  }

  .cat-count {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    background: var(--white-05);
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
    border: 1px solid var(--white-10);
  }

  .deals-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .deal-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1rem;
    border-radius: 12px;
    transition: background 0.2s;
  }

  .deal-row:hover {
    background: var(--white-02);
  }

  .deal-row + .deal-row {
    border-top: 1px solid var(--border-subtle);
  }

  .deal-logo {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    position: relative;
  }

  .deal-logo img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: contain;
    background: var(--white-10);
  }

  .deal-logo-fallback {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--bg-primary);
  }

  .deal-info {
    flex: 1;
    min-width: 0;
  }

  .deal-name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .deal-name-row h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .deal-name-row h3 a {
    color: var(--text-primary);
    transition: color 0.2s;
  }

  .deal-name-row h3 a:hover {
    color: var(--accent-primary);
  }

  .highlight-badge {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    background: color-mix(in srgb, var(--accent-primary) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-primary) 30%, transparent);
    border-radius: 50px;
    color: var(--accent-primary);
    white-space: nowrap;
  }

  .deal-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0 0 0.4rem;
    line-height: 1.5;
  }

  .deal-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pricing-tag {
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 0.15rem 0.5rem;
    background: var(--white-05);
    border: 1px solid var(--white-10);
    border-radius: 50px;
  }

  .deal-cta {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .btn-deal {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.25rem;
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transition: all 0.2s;
  }

  .btn-deal:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px -6px var(--accent-primary);
  }

  .review-link {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: right;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .review-link:hover {
    color: var(--text-secondary);
  }

  /* Disclosure */
  .disclosure {
    padding: 1.25rem 1.5rem;
    background: var(--white-02);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    margin-top: 3rem;
    margin-bottom: 3rem;
  }

  .disclosure p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Bottom CTA */
  .bottom-cta {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--white-02);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
  }

  .bottom-cta h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .bottom-cta p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .btn-primary-lg {
    display: inline-block;
    padding: 0.875rem 2rem;
    background: var(--accent-primary);
    color: var(--bg-primary);
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .btn-primary-lg:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px var(--accent-primary);
  }

  @media (max-width: 768px) {
    .deals-page {
      padding: 7rem 1.25rem 3rem;
    }

    .trust-bar {
      gap: 0.75rem;
      font-size: 0.8rem;
    }

    .deal-row {
      flex-wrap: wrap;
    }

    .deal-cta {
      flex-direction: row;
      align-items: center;
      width: 100%;
    }

    .review-link {
      text-align: left;
    }
  }
</style>
