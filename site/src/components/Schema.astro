---
/**
 * Schema.astro - JSON-LD Structured Data for SEO
 * Supports: Organization, WebSite, SoftwareApplication, ItemList, BreadcrumbList
 */

interface Tool {
  name: string;
  slug: string;
  description?: string;
  category?: string;
  pricing?: string;
  rating?: number;
  reviewCount?: number;
  url?: string;
  logo?: string;
}

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  type: 'organization' | 'website' | 'tool' | 'itemList' | 'breadcrumb';
  tool?: Tool;
  tools?: Tool[];
  breadcrumbs?: BreadcrumbItem[];
  listName?: string;
}

const { type, tool, tools, breadcrumbs, listName } = Astro.props;
const siteUrl = 'https://www.ai-tools-hq.com';

// Organization Schema - appears on all pages
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AI Tools HQ",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "description": "Curated AI tools directory with honest reviews and comparisons",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer support",
    "url": `${siteUrl}/contact`
  }
};

// WebSite Schema with SearchAction - enables sitelinks search box in Google
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AI Tools HQ",
  "url": siteUrl,
  "description": "Find the best AI tool in 60 seconds. 500+ tools with ratings, pricing & honest reviews.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/tools?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

// SoftwareApplication Schema for tool pages
const getToolSchema = (t: Tool) => ({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": t.name,
  "description": t.description || `${t.name} - AI tool for ${t.category || 'productivity'}`,
  "url": `${siteUrl}/tools/${t.slug}`,
  "applicationCategory": mapCategory(t.category),
  "operatingSystem": "Web, iOS, Android",
  "offers": {
    "@type": "Offer",
    "price": t.pricing?.toLowerCase().includes('free') ? "0" : undefined,
    "priceCurrency": "USD",
    "availability": "https://schema.org/OnlineOnly"
  },
  ...(t.rating && t.reviewCount && {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": t.rating.toFixed(1),
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": t.reviewCount
    }
  }),
  ...(t.logo && {
    "image": t.logo
  })
});

// ItemList Schema for category/list pages
const getItemListSchema = (items: Tool[], name: string) => ({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": name,
  "numberOfItems": items.length,
  "itemListElement": items.slice(0, 50).map((t, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": t.name,
    "url": `${siteUrl}/tools/${t.slug}`
  }))
});

// BreadcrumbList Schema for navigation
const getBreadcrumbSchema = (items: BreadcrumbItem[]) => ({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    "item": item.url.startsWith('http') ? item.url : `${siteUrl}${item.url}`
  }))
});

// Map our categories to schema.org applicationCategory
function mapCategory(category?: string): string {
  const mapping: Record<string, string> = {
    'writing': 'BusinessApplication',
    'image': 'MultimediaApplication',
    'video': 'MultimediaApplication',
    'audio': 'MultimediaApplication',
    'coding': 'DeveloperApplication',
    'productivity': 'BusinessApplication',
    'marketing': 'BusinessApplication',
    'data': 'BusinessApplication',
    'research': 'EducationalApplication',
    'chatbot': 'UtilitiesApplication',
    'automation': 'UtilitiesApplication'
  };
  return mapping[category?.toLowerCase() || ''] || 'BusinessApplication';
}

// Build the schemas based on type
let schemas: object[] = [];

if (type === 'organization') {
  schemas = [organizationSchema];
} else if (type === 'website') {
  schemas = [organizationSchema, websiteSchema];
} else if (type === 'tool' && tool) {
  schemas = [
    organizationSchema,
    getToolSchema(tool),
    ...(breadcrumbs ? [getBreadcrumbSchema(breadcrumbs)] : [])
  ];
} else if (type === 'itemList' && tools) {
  schemas = [
    organizationSchema,
    getItemListSchema(tools, listName || 'AI Tools'),
    ...(breadcrumbs ? [getBreadcrumbSchema(breadcrumbs)] : [])
  ];
} else if (type === 'breadcrumb' && breadcrumbs) {
  schemas = [organizationSchema, getBreadcrumbSchema(breadcrumbs)];
}
---

{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 0)} />
))}
