---
import type { Tool } from '../lib/supabase';
import { classifyPricing } from '../lib/seo-utils';

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

// Extract domain from website URL
function getDomain(url: string): string {
  try {
    return new URL(url).hostname.replace('www.', '');
  } catch {
    return '';
  }
}

const domain = getDomain(tool.website);
const logoUrl = domain ? `https://img.logo.dev/${domain}?token=pk_VAZ6EX0OSROxLyDRLvERhg` : '';

const isFeatured = tool.featured === true;
const isEditorsPick = !isFeatured && ['Writing', 'Coding'].includes(tool.category);
const isPopular = !isFeatured && !isEditorsPick && ['Image', 'Video'].includes(tool.category);

// "New" badge — tools added within last 14 days
const isNew = (!isFeatured && !isEditorsPick && !isPopular && tool.created_at)
  ? (Date.now() - new Date(tool.created_at).getTime()) < 14 * 24 * 60 * 60 * 1000
  : false;

const categoryVars: Record<string, string> = {
  'Writing': '--cat-writing',
  'Image': '--cat-image',
  'Video': '--cat-video',
  'Audio': '--cat-audio',
  'Coding': '--cat-coding',
  'Productivity': '--cat-productivity',
  'Marketing': '--cat-marketing',
  'Data': '--cat-data'
};

const accentVar = categoryVars[tool.category] || '--accent-primary';
const accentValue = `var(${accentVar})`;
const pricing = classifyPricing(tool.pricing);

// Upgrade affiliate link: homepage → pricing/trial page + sub1=card-{slug} attribution
const buildCardLink = (affiliateLink: string, slug: string): string => {
  if (!affiliateLink) return tool.website || '#';
  let url = affiliateLink
    .replace('https://synthesia.io?', 'https://synthesia.io/pricing?')
    .replace('https://baremetrics.com/?', 'https://baremetrics.com/pricing?')
    .replace('https://www.signwell.com/?', 'https://app.signwell.com/accounts/sign-up?')
    .replace('https://emailoctopus.com/?', 'https://emailoctopus.com/pricing?')
    .replace('https://outseta.com/?', 'https://outseta.com/pricing?')
    .replace('https://www.heygen.com?', 'https://www.heygen.com/pricing?')
    .replace('https://www.make.com?', 'https://www.make.com/en/register?')
    .replace('https://www.descript.com?', 'https://www.descript.com/pricing?');
  if (!url.includes('sub1=')) {
    url += (url.includes('?') ? '&' : '?') + `sub1=card-${slug}`;
  }
  return url;
};

const cardLink = buildCardLink(tool.affiliateLink, tool.slug);

const shortDesc = tool.description && tool.description.length > 100
  ? tool.description.slice(0, 97) + '...'
  : tool.description || '';
---

<article class={`tool-card${isFeatured ? ' tool-card-featured' : ''}`} style={`--card-accent: ${accentValue}`}>
  <div class="card-glow"></div>

  <!-- Badge -->
  {isFeatured && (
    <span class="badge badge-featured">Featured</span>
  )}
  {isEditorsPick && (
    <span class="badge badge-editors">✨ Editor's Pick</span>
  )}
  {isPopular && (
    <span class="badge badge-popular">🔥 Popular</span>
  )}
  {isNew && (
    <span class="badge badge-new">🆕 New</span>
  )}

  <!-- Header with Logo -->
  <div class="card-header">
    <div class="logo-row">
      {logoUrl ? (
        <div class="logo-wrapper">
          <img
            src={logoUrl}
            alt={`${tool.name} logo`}
            width="48"
            height="48"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="logo-fallback" style={`background: ${accentValue}; display: none;`} role="img" aria-label={`${tool.name} logo`}>
            {tool.name.charAt(0).toUpperCase()}
          </div>
        </div>
      ) : (
        <div class="logo-fallback" style={`background: ${accentValue}`} role="img" aria-label={`${tool.name} logo`}>
          {(tool.name?.charAt(0) || '?').toUpperCase()}
        </div>
      )}
      <div class="title-section">
        <h3><a href={`/tools/${tool.slug}`}>{tool.name}</a></h3>
      </div>
    </div>

    <div class="card-meta">
      <span class="category-badge">{tool.category}</span>
      <span class="pricing-badge" style={`--pricing-color: ${pricing.color}`}>{pricing.label}</span>
    </div>
  </div>

  <p class="description">{shortDesc}</p>

  <div class="card-footer">
    <a href={`/tools/${tool.slug}`} class="btn-review">
      <span>Read Review</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
    <a href={cardLink} class="btn-try" target="_blank" rel="noopener sponsored">
      <span>Try Free</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </div>

  <div class="card-border"></div>
</article>

<style>
  .tool-card {
    --card-accent: var(--accent-primary);

    position: relative;
    background: var(--white-02);
    border-radius: 20px;
    padding: 1.75rem;
    transition: all 0.4s var(--ease-out-expo);
    overflow: hidden;
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--card-accent) 50%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .card-border {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    padding: 1px;
    background: linear-gradient(135deg,
      var(--white-10) 0%,
      var(--white-05) 50%,
      var(--white-02) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    transition: all 0.4s var(--ease-out-expo);
  }

  .tool-card:hover {
    background: var(--white-04);
    transform: translateY(-8px);
  }

  .tool-card:hover .card-glow {
    opacity: 0.8;
  }

  .tool-card:hover .card-border {
    background: linear-gradient(135deg,
      var(--card-accent) 0%,
      var(--white-10) 50%,
      transparent 100%
    );
  }

  /* Badge styles */
  .badge {
    position: absolute;
    top: -8px;
    right: 16px;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    z-index: 10;
    box-shadow: var(--shadow-md);
  }

  .badge-featured {
    background: linear-gradient(135deg, #f59e0b, #d97706); /* ds-exception: featured sponsor gradient */
    color: var(--bg-primary);
  }

  .tool-card-featured {
    border: 1px solid rgba(245, 158, 11, 0.3); /* ds-exception: featured border */
  }

  .tool-card-featured .card-border {
    background: linear-gradient(135deg,
      rgba(245, 158, 11, 0.4) 0%,
      var(--white-10) 50%,
      transparent 100%
    );
  }

  /* Secondary tier: quiet gold outline so Featured stays the one standout.
     The emoji label carries the distinction (Editor's / Popular / New). */
  .badge-editors,
  .badge-popular,
  .badge-new {
    background: color-mix(in srgb, var(--accent-primary) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-primary) 35%, transparent);
    color: var(--accent-primary);
    box-shadow: none;
    backdrop-filter: blur(8px);
  }

  /* Header styles */
  .card-header {
    margin-bottom: 1rem;
  }

  .logo-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .logo-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .logo-wrapper img {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: contain;
    background: var(--white-10);
  }

  .logo-fallback {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--bg-primary);
    flex-shrink: 0;
  }

  .title-section {
    flex: 1;
    min-width: 0;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    margin: 0;
    line-height: 1.3;
  }

  h3 a {
    color: var(--text-primary);
    transition: color 0.3s var(--ease-out-expo);
  }

  h3 a:hover {
    color: var(--card-accent);
  }

  /* Meta row */
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .category-badge {
    padding: 0.3rem 0.75rem;
    background: var(--bg-card-hover);
    border: 1px solid var(--white-10);
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--card-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pricing-badge {
    padding: 0.3rem 0.75rem;
    background: color-mix(in srgb, var(--pricing-color) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--pricing-color) 40%, transparent);
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--pricing-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .card-footer {
    display: flex;
    gap: 0.75rem;
  }

  .btn-review, .btn-try {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s var(--ease-out-expo);
  }

  .btn-review {
    background: var(--white-05);
    border: 1px solid var(--white-10);
    color: var(--text-primary);
  }

  .btn-review:hover {
    background: var(--white-10);
    border-color: var(--white-20);
    transform: translateY(-2px);
  }

  .btn-review svg {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .btn-review:hover svg {
    transform: translateX(3px);
  }

  /* Primary CTA always uses the brand gold — category colour stays a subtle
     cue (logo tint, category badge, hover glow) so the grid reads as one brand. */
  .btn-try {
    background: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    color: var(--bg-primary);
    font-weight: 600;
  }

  .btn-try:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
    box-shadow: var(--shadow-accent-lg);
  }

  .btn-try svg {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .btn-try:hover svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .tool-card {
      padding: 1.25rem;
    }

    .logo-row {
      gap: 0.75rem;
    }

    .logo-wrapper img,
    .logo-fallback {
      width: 40px;
      height: 40px;
    }

    h3 {
      font-size: 1.15rem;
    }

    .badge {
      right: 12px;
      padding: 0.25rem 0.5rem;
      font-size: 0.65rem;
    }

    .card-footer {
      flex-direction: column;
    }
  }
</style>
