---
// Newsletter signup component — saves to Supabase newsletter_subscribers table
---

<section class="newsletter-section">
  <div class="newsletter-glow"></div>
  <div class="newsletter-inner">
    <div class="newsletter-copy">
      <h3 class="newsletter-headline">Get the best AI tools in your inbox</h3>
      <p class="newsletter-subtext">Weekly picks, reviews, and deals. No spam.</p>
    </div>

    <form id="newsletter-form" class="newsletter-form">
      <div class="form-row">
        <input
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-btn">
          <span class="btn-text">Subscribe</span>
          <span class="btn-loading" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </span>
          <span class="btn-check" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </span>
        </button>
      </div>
      <p class="newsletter-msg newsletter-msg--success" aria-live="polite">You're in! Check your inbox soon.</p>
      <p class="newsletter-msg newsletter-msg--error" aria-live="polite">Something went wrong. Try again?</p>
    </form>
  </div>
  <div class="newsletter-border"></div>
</section>

<script>
  const SUPABASE_URL = 'https://ebhtzgimevacvcgiyesc.supabase.co';
  const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImViaHR6Z2ltZXZhY3ZjZ2l5ZXNjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTI4MDIyMTksImV4cCI6MjA2ODM3ODIxOX0.msMqXGX33MIygHQWG4n2BdP8JVLOR9Yi5WkiDRwZEbY';

  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('.newsletter-btn') as HTMLButtonElement;
      const successMsg = form.querySelector('.newsletter-msg--success') as HTMLElement;
      const errorMsg = form.querySelector('.newsletter-msg--error') as HTMLElement;
      const input = form.querySelector('.newsletter-input') as HTMLInputElement;

      successMsg.classList.remove('visible');
      errorMsg.classList.remove('visible');
      btn.classList.add('loading');
      btn.disabled = true;

      const email = input.value.trim();

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/newsletter_subscribers`, {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal',
          },
          body: JSON.stringify({ email, source: 'ai-tools-hq' }),
        });

        if (res.ok) {
          btn.classList.remove('loading');
          btn.classList.add('success');
          successMsg.classList.add('visible');
          input.value = '';
          setTimeout(() => {
            btn.classList.remove('success');
            btn.disabled = false;
          }, 4000);
        } else if (res.status === 409) {
          // Duplicate email — treat as success
          btn.classList.remove('loading');
          btn.classList.add('success');
          successMsg.textContent = "You're already subscribed!";
          successMsg.classList.add('visible');
          input.value = '';
          setTimeout(() => {
            btn.classList.remove('success');
            btn.disabled = false;
            successMsg.textContent = "You're in! Check your inbox soon.";
          }, 4000);
        } else {
          throw new Error('Submit failed');
        }
      } catch {
        btn.classList.remove('loading');
        errorMsg.classList.add('visible');
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .newsletter-section {
    position: relative;
    max-width: 720px;
    margin: 4rem auto 0;
    padding: 2.5rem 2.5rem 2rem;
    background: var(--bg-card);
    border-radius: 20px;
    overflow: hidden;
  }

  .newsletter-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--accent-primary) 50%,
      transparent 100%
    );
    opacity: 0.8;
  }

  .newsletter-border {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    padding: 1px;
    background: linear-gradient(135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(255, 255, 255, 0.02) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .newsletter-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .newsletter-headline {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .newsletter-subtext {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .newsletter-input {
    flex: 1;
    padding: 0.875rem 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: all 0.3s var(--ease-out-expo);
  }

  .newsletter-input::placeholder {
    color: var(--text-muted);
  }

  .newsletter-input:focus {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px var(--accent-glow);
    background: rgba(255, 255, 255, 0.07);
  }

  .newsletter-btn {
    position: relative;
    padding: 0.875rem 1.75rem;
    background: var(--accent-primary);
    color: var(--bg-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s var(--ease-out-expo);
    white-space: nowrap;
    overflow: hidden;
  }

  .newsletter-btn:hover:not(:disabled) {
    background: var(--accent-secondary);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -8px var(--accent-glow);
  }

  .newsletter-btn:disabled {
    cursor: not-allowed;
  }

  /* Button states */
  .btn-loading,
  .btn-check {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: none;
  }

  .newsletter-btn.loading .btn-text { visibility: hidden; }
  .newsletter-btn.loading .btn-loading {
    display: block;
    animation: spin 1s linear infinite;
  }

  .newsletter-btn.success .btn-text { visibility: hidden; }
  .newsletter-btn.success .btn-check {
    display: block;
    animation: popIn 0.3s var(--ease-out-back);
  }

  .newsletter-btn.success {
    background: #10b981;
  }

  @keyframes spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes popIn {
    from { transform: translate(-50%, -50%) scale(0); }
    to { transform: translate(-50%, -50%) scale(1); }
  }

  /* Messages */
  .newsletter-msg {
    font-size: 0.85rem;
    margin-top: 0.75rem;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: all 0.3s var(--ease-out-expo);
  }

  .newsletter-msg.visible {
    opacity: 1;
    max-height: 2rem;
  }

  .newsletter-msg--success {
    color: #10b981;
  }

  .newsletter-msg--error {
    color: #ef4444;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .newsletter-section {
      margin: 3rem 0 0;
      padding: 2rem 1.5rem 1.5rem;
      border-radius: 16px;
    }

    .newsletter-headline {
      font-size: 1.35rem;
    }

    .form-row {
      flex-direction: column;
    }

    .newsletter-btn {
      width: 100%;
    }
  }
</style>
